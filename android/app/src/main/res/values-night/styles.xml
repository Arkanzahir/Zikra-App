<resources>
    <style name="Theme.Zikra.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="zikraSymbol">@drawable/zikra_refined_white</item>
        <item name="zikraInk">@color/text</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorButtonNormal">@color/mint_pastel</item>
        <item name="android:buttonStyle">@style/Widget.Zikra.Button</item>
        <item name="android:alertDialogTheme">@style/Theme.Zikra.Dialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/pine</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Theme.Zikra.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
    <style name="ZikraBrandLight">
        <item name="zikraSymbol">@drawable/zikra_refined_white</item>
        <item name="zikraInk">@color/text</item>
    </style>
</resources>
