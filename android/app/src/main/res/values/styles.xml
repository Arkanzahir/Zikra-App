<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Theme.Zikra.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="zikraSymbol">@drawable/zikra_symbol_pine</item>
        <item name="zikraInk">@color/text</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorButtonNormal">@color/mint_pastel</item>
        <item name="android:buttonStyle">@style/Widget.Zikra.Button</item>
        <item name="android:alertDialogTheme">@style/Theme.Zikra.Dialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/pine</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Theme.Zikra.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:colorBackground">@color/app_surface</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
    <style name="Theme.Zikra" parent="Theme.Zikra.Base" />
    <style name="ShortcutLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="ShortcutIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="DockLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
    <style name="Theme.Zikra.Home" parent="Theme.Zikra">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="Widget.Zikra.Button" parent="android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
