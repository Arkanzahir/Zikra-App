<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="onboard_orbit_size">300dp</dimen>
    <style name="OnboardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/pine</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
    </style>
    <style name="OnboardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#6A7D75</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="OnboardLevelCard">
        <item name="android:layout_height">154dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/onboard_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
    <style name="OnboardLevelTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/pine</item>
    </style>
    <style name="OnboardLevelCaption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#6A7D75</item>
    </style>
</resources>
