    <style name="StudyLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pine</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StudyChoice">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/study_choice</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pine</item>
    </style>
    <style name="StudyInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/study_input</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/pine</item>
        <item name="android:textColorHint">#65786F</item>
    </style>
    <style
        name="HifzInput"
        parent="StudyInput">
        <item name="android:inputType">number</item>
        <item name="android:maxLength">3</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="StudyButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style
        name="StudySheet.Base"
        parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:colorAccent">@color/pine</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>
    <style
        name="StudySheet"
        parent="StudySheet.Base" />
</resources>
