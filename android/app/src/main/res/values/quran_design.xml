<resources>
    <style name="QuranSheetRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">64dp</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item><item name="android:paddingVertical">6dp</item></style>
    <style name="QuranSheetColumn"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item></style>
    <style name="QuranSheetIcon"><item name="android:layout_width">24dp</item><item name="android:layout_height">24dp</item><item name="android:layout_marginEnd">16dp</item><item name="android:tint">@color/text</item><item name="android:importantForAccessibility">no</item></style>
    <style name="QuranSheetLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">13sp</item><item name="android:textColor">@color/text</item></style>
    <style name="QuranSheetValue"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textSize">12sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="QuranSheetPicker"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">48dp</item><item name="android:spinnerMode">dropdown</item></style>
    <style name="QuranSheetDivider"><item name="android:layout_width">match_parent</item><item name="android:layout_height">1dp</item><item name="android:background">#E9EDE8</item></style>
    <style name="QuranSheetSwitch"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">56dp</item><item name="android:textSize">13sp</item><item name="android:textColor">@color/text</item><item name="android:paddingVertical">8dp</item><item name="android:switchPadding">12dp</item><item name="android:buttonTint">@color/pine</item><item name="android:thumbTint">@color/pine</item></style>
    <style name="QuranSheetNumber"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">48dp</item><item name="android:inputType">number</item><item name="android:maxLength">3</item><item name="android:singleLine">true</item><item name="android:textSize">16sp</item><item name="android:textColor">@color/text</item></style>
    <style name="QuranSheetAnimation"><item name="android:windowEnterAnimation">@anim/quran_sheet_in</item><item name="android:windowExitAnimation">@anim/quran_sheet_out</item></style>
</resources>
