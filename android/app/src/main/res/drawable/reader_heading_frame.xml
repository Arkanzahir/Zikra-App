<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@android:color/transparent"/><stroke android:width="0.6dp" android:color="#66B69A62"/><corners android:radius="8dp"/></shape></item>
    <item android:width="28dp" android:height="28dp" android:gravity="top|left" android:drawable="@drawable/reader_heading_corner"/>
    <item android:width="28dp" android:height="28dp" android:gravity="top|right"><rotate android:fromDegrees="90" android:toDegrees="90" android:pivotX="50%" android:pivotY="50%" android:drawable="@drawable/reader_heading_corner"/></item>
    <item android:width="28dp" android:height="28dp" android:gravity="bottom|right"><rotate android:fromDegrees="180" android:toDegrees="180" android:pivotX="50%" android:pivotY="50%" android:drawable="@drawable/reader_heading_corner"/></item>
    <item android:width="28dp" android:height="28dp" android:gravity="bottom|left"><rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%" android:drawable="@drawable/reader_heading_corner"/></item>
</layer-list>