<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/app_surface_e8f0eb" />
            <stroke
                android:width="1dp"
                android:color="#42665B" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/app_surface_ffffff" />
            <stroke
                android:width="1dp"
                android:color="@color/app_line_dde5e0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
