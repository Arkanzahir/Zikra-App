<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false">
        <shape>
            <solid
                android:color="#E9EEF5" />
            <corners
                android:radius="14dp" />
        </shape>
    </item>
    <item
        android:state_pressed="true">
        <shape>
            <solid
                android:color="#2454D0" />
            <corners
                android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid
                android:color="#3569F3" />
            <corners
                android:radius="14dp" />
        </shape>
    </item>
</selector>
