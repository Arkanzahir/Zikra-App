<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <include
        layout="@layout/protector_toolbar" />
    <ScrollView
        android:id="@+id/protectorScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/protector_screen_padding"
            android:paddingBottom="24dp">
            <FrameLayout
                android:id="@+id/protectorWeatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="156dp"
                android:background="@drawable/protector_weather_bg"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:contentDescription="Buka detail prakiraan cuaca Sukolilo">
                <com.zikra.app.safety.WeatherArtworkView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_pin"
                            android:importantForAccessibility="no"
                            android:tint="#E8F0FF" />
                        <TextView
                            style="@style/ProtectorBody"
                            android:text="Sukolilo, Surabaya"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:textColor="#E8F0FF"
                            android:textSize="11sp" />
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:src="@drawable/protector_ic_chevron"
                            android:importantForAccessibility="no"
                            android:tint="@color/white" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="11dp"
                        android:minHeight="59dp">
                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/weather_symbol_cloud"
                            android:importantForAccessibility="no"
                            android:id="@+id/protectorWeatherIcon" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                style="@style/ProtectorHeading"
                                android:text="Memuat prakiraan…"
                                android:id="@+id/protectorWeatherDescription"
                                android:textColor="@color/white"
                                android:textSize="13sp" />
                            <TextView
                                style="@style/ProtectorBody"
                                android:text="Waktu prakiraan belum tersedia"
                                android:id="@+id/protectorWeatherTime"
                                android:textColor="#DEE8FF"
                                android:textSize="10sp"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <TextView
                            style="@style/ProtectorHeading"
                            android:text="—°C"
                            android:id="@+id/protectorWeatherTemperature"
                            android:layout_width="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="42sp"
                            android:fontFeatureSettings="tnum"
                            android:gravity="end"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="12dp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#26FFFFFF" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Menghubungkan ke BMKG"
                        android:id="@+id/protectorWeatherStatus"
                        android:textColor="#EEF3FF"
                        android:textSize="10sp"
                        android:layout_marginTop="9dp" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Prakiraan Keputih, Sukolilo"
                        android:id="@+id/protectorWeatherDetails"
                        android:textColor="#DAE6FF"
                        android:textSize="10sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:id="@+id/protectorWarnings"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/protector_warning"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:src="@drawable/protector_ic_warning"
                    android:importantForAccessibility="no"
                    android:tint="#CB9340" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp">
                    <TextView
                        style="@style/ProtectorHeading"
                        android:text="Peringatan dini cuaca"
                        android:textSize="12sp"
                        android:textColor="#AA7626" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Lihat informasi resmi untuk wilayahmu"
                        android:textSize="10sp"
                        android:textColor="#A28559"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/protector_ic_chevron"
                    android:importantForAccessibility="no"
                    android:tint="#CB9340" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                android:minHeight="44dp">
                <TextView
                    style="@style/ProtectorHeading"
                    android:text="Gempabumi terkini"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textSize="16sp" />
                <TextView
                    style="@style/ProtectorBody"
                    android:text="Lihat detail"
                    android:id="@+id/protectorQuakeOpen"
                    android:layout_width="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:textColor="@color/protector_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/protectorQuakeCard"
                android:background="@drawable/protector_white_card"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:contentDescription="Buka detail gempabumi terakhir BMKG">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/protector_map_height">
                    <com.zikra.app.safety.IndonesiaMapView
                        android:id="@+id/protectorQuakeMap"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_gravity="bottom"
                        android:padding="10dp"
                        android:gravity="center_vertical">
                        <TextView
                            style="@style/ProtectorBody"
                            android:text="BMKG · Indonesia"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:textSize="9sp"
                            android:textColor="@color/protector_blue"
                            android:textStyle="bold"
                            android:background="@drawable/protector_circle_white" />
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />
                        <TextView
                            style="@style/ProtectorHeading"
                            android:text="M —"
                            android:id="@+id/protectorMagnitude"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:textSize="11sp"
                            android:textColor="#D16A70"
                            android:background="@drawable/protector_circle_white" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <TextView
                        style="@style/ProtectorHeading"
                        android:text="Memuat laporan gempa…"
                        android:id="@+id/protectorQuakeArea"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Waktu kejadian belum tersedia"
                        android:id="@+id/protectorQuakeTime"
                        android:textSize="10sp"
                        android:layout_marginTop="6dp" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Data resmi BMKG · Indonesia"
                        android:id="@+id/protectorQuakeStatus"
                        android:textSize="10sp"
                        android:layout_marginTop="4dp" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Lokasi episentrum menunggu data BMKG."
                        android:id="@+id/protectorQuakeDetails"
                        android:textSize="11sp"
                        android:layout_marginTop="9dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/protector_soft_card"
                android:padding="16dp"
                android:layout_marginTop="16dp">
                <TextView
                    style="@style/ProtectorHeading"
                    android:text="Tetap tenang, tetap siap"
                    android:textSize="14sp" />
                <TextView
                    style="@style/ProtectorBody"
                    android:text="Goyangkan ponsel dua kali untuk membuka bantuan cepat."
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
                <Button
                    style="@style/ProtectorButton"
                    android:id="@+id/protectorDial"
                    android:text="Panggilan darurat · 112"
                    android:layout_marginTop="14dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false">
                    <Button
                        android:id="@+id/protectorWhatsapp"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/protector_tag_mint"
                        android:text="WhatsApp"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textColor="#39816A"
                        android:stateListAnimator="@null"
                        android:layout_marginEnd="5dp" />
                    <Button
                        android:id="@+id/protectorMaps"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/protector_tag_blue"
                        android:text="Masjid sekitar"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        android:textColor="#3569F3"
                        android:stateListAnimator="@null"
                        android:layout_marginStart="5dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/ProtectorBody"
                android:text="Sumber: BMKG · Buka situs resmi ↗"
                android:id="@+id/protectorSource"
                android:textSize="10sp"
                android:minHeight="48dp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </ScrollView>
    <include
        layout="@layout/protector_navigation" />
</LinearLayout>
