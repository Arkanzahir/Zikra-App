<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qiblaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader
            android:id="@+id/sharedFeatureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ScrollView
            android:id="@+id/qiblaScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="110dp"
            android:scrollbars="none"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="20dp">
                <Button android:id="@+id/qiblaLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Ubah lokasi" android:textAllCaps="false" android:textColor="@color/pine" />
                <com.zikra.app.reading.QiblaCompassView
                    android:id="@+id/qiblaCompass"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/qibla_dial_size"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Kompas kiblat 294 derajat dari utara sejati" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:id="@+id/qiblaBearing"
                    android:text="294°"
                    android:textSize="34sp"
                    android:textColor="#20362D"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Derajat dihitung dari utara sejati"
                    android:textSize="12sp"
                    android:textColor="#53665E" />
                <Button
                    android:id="@+id/qiblaCalibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/qibla_bg_green"
                    android:text="Panduan kalibrasi"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:stateListAnimator="@null"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:minHeight="52dp"
                    android:paddingVertical="12dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/qibla_bg_instruction"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/qibla_ic_info"
                        android:tint="#96A39B"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/qiblaSensorStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Menunggu sensor · pegang ponsel mendatar."
                        android:textColor="#536C60"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:minHeight="30dp"
                        android:gravity="center_vertical"
                        android:accessibilityLiveRegion="none" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="11dp"
                    android:text="Masjid di sekitar lokasi"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#243B30" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/qibla_bg_nearby"
                    android:paddingHorizontal="12dp"
                    android:minHeight="76dp"
                    android:paddingVertical="12dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:src="@drawable/qibla_ic_mosque"
                        android:tint="@color/sage"
                        android:background="@drawable/qibla_bg_instruction"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Masjid terdekat"
                            android:textColor="#334C3F"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:id="@+id/qiblaLocationLabel" android:text="Lokasi pilihan"
                            android:textColor="#53665E"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/qiblaMaps"
                        android:layout_width="52dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="Buka ↗"
                        android:textColor="@color/sage"
                        android:textSize="12sp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Buka daftar dan peta masjid terdekat"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:id="@+id/qiblaMethod" android:text="Arah dihitung dari lokasi pilihan. Jauhkan ponsel dari logam dan magnet."
                    android:textSize="12sp"
                    android:textColor="#53665E"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
