<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hadithRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/daily_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader android:id="@+id/utilitiesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ScrollView android:id="@+id/hadithScroll" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:paddingBottom="112dp" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingHorizontal="20dp">
                <FrameLayout android:id="@+id/hadithHero" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="96dp" android:layout_marginBottom="16dp"
                    android:background="@drawable/daily_pine_card" android:clipToOutline="true"
                    android:clickable="true" android:focusable="true" android:contentDescription="@string/daily_hadith_hero_access">
                    <ImageView android:layout_width="match_parent" android:layout_height="96dp"
                        android:src="@drawable/daily_books" android:scaleType="centerCrop" android:importantForAccessibility="no" />
                    <View android:layout_width="match_parent" android:layout_height="96dp" android:background="@drawable/daily_hero_scrim" />
                    <LinearLayout android:layout_width="212dp" android:layout_height="wrap_content"
                        android:minHeight="96dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp">
                        <TextView style="@style/DailyCaption" android:text="@string/daily_hadith_eyebrow"
                            android:textColor="@color/daily_sand" android:textSize="9sp" android:letterSpacing="0.08" />
                        <TextView style="@style/DailyHeading" android:text="@string/hadith_refined_hero"
                            android:textSize="19sp" android:textColor="@color/daily_white" android:layout_marginTop="6dp" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:background="@drawable/reading_search"
                    android:paddingHorizontal="14dp" android:layout_marginBottom="16dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/reading_ic_search" android:importantForAccessibility="no" />
                    <EditText android:id="@+id/hadithSearch" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:minHeight="52dp" android:maxLength="200"
                        android:layout_marginStart="10dp" android:background="@null"
                        android:hint="@string/hadith_refined_search" android:textColor="@color/daily_ink"
                        android:textColorHint="@color/hadith_secondary" android:textSize="14sp" android:singleLine="true"
                        android:inputType="text" android:imeOptions="actionSearch" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/hadithBooks" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false" android:layout_marginBottom="12dp">
                    <LinearLayout android:id="@+id/dailyBookBukhari" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:minHeight="96dp" android:orientation="horizontal"
                        android:gravity="center_vertical" android:padding="12dp" android:layout_marginEnd="6dp"
                        android:background="@drawable/hadith_book_background" android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:contentDescription="@string/daily_book_bukhari">
                        <com.zikra.app.ui.BookCoverView android:id="@+id/dailyCoverBukhari"
                            android:layout_width="40dp" android:layout_height="55dp" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="10dp">
                            <TextView style="@style/HadithLabel" android:text="@string/hadith_refined_sahih" android:textSize="9sp" />
                            <TextView style="@style/DailyHeading" android:text="@string/hadith_refined_bukhari" android:textSize="15sp" android:layout_marginTop="3dp" />
                            <TextView style="@style/DailyCaption" android:text="@string/daily_author_bukhari"
                                android:textColor="@color/hadith_secondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/dailyBookMuslim" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:minHeight="96dp" android:orientation="horizontal"
                        android:gravity="center_vertical" android:padding="12dp" android:layout_marginStart="6dp"
                        android:background="@drawable/hadith_book_background" android:foreground="?android:attr/selectableItemBackground"
                        android:clickable="true" android:focusable="true" android:contentDescription="@string/daily_book_muslim">
                        <com.zikra.app.ui.BookCoverView android:id="@+id/dailyCoverMuslim"
                            android:layout_width="40dp" android:layout_height="55dp" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginStart="10dp">
                            <TextView style="@style/HadithLabel" android:text="@string/hadith_refined_sahih" android:textSize="9sp" />
                            <TextView style="@style/DailyHeading" android:text="@string/hadith_refined_muslim" android:textSize="15sp" android:layout_marginTop="3dp" />
                            <TextView style="@style/DailyCaption" android:text="@string/daily_author_muslim"
                                android:textColor="@color/hadith_secondary" android:textSize="10sp" android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:id="@+id/dailyHadithResume" style="@style/DailyButton"
                    android:text="@string/daily_continue_hadith" android:gravity="center_vertical"
                    android:textSize="12sp" android:drawableStart="@drawable/reading_ic_bookmark"
                    android:drawableEnd="@drawable/home_ic_chevron" android:drawablePadding="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:scrollbars="none">
                        <LinearLayout android:id="@+id/hadithTabs" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>
                    <Button android:id="@+id/hadithDownloads" style="@style/ReadingButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:minWidth="0dp" android:paddingHorizontal="12dp" android:background="@drawable/daily_white_card"
                        android:backgroundTint="@null" android:textColor="@color/daily_ink" android:textSize="12sp"
                        android:text="@string/hadith_refined_downloads" />
                </LinearLayout>
                <TextView android:id="@+id/hadithCount" style="@style/DailyHeading" android:textSize="14sp"
                    android:text="@string/hadith_loading" android:layout_marginTop="16dp" />
                <TextView android:id="@+id/hadithStatus" style="@style/DailyCaption" android:textSize="11sp"
                    android:textColor="@color/hadith_secondary" android:text="@string/hadith_search_scope"
                    android:paddingTop="6dp" android:paddingBottom="12dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/hadithCancelDownload" style="@style/ReadingButton"
                    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/hadith_cancel_download" android:visibility="gone" />
                <TextView android:id="@+id/hadithEmpty" style="@style/DailyCaption"
                    android:text="@string/hadith_collection_empty" android:visibility="gone"
                    android:paddingVertical="24dp" android:accessibilityLiveRegion="polite" />
                <LinearLayout android:id="@+id/hadithPager" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <Button android:id="@+id/hadithPrevious" style="@style/ReadingButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:background="@drawable/daily_white_card" android:textColor="@color/daily_ink"
                        android:textSize="12sp" android:text="@string/hadith_previous" android:layout_marginEnd="4dp" />
                    <Button android:id="@+id/hadithNext" style="@style/ReadingButton" android:layout_width="0dp"
                        android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                        android:background="@drawable/daily_white_card" android:textColor="@color/daily_ink"
                        android:textSize="12sp" android:text="@string/hadith_next" android:layout_marginStart="4dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/hadithList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:background="@drawable/daily_white_card" android:clipToOutline="true" />
                <TextView android:id="@+id/hadithSource" style="@style/DailyCaption"
                    android:text="@string/hadith_refined_source" android:textColor="@color/hadith_secondary"
                    android:gravity="center" android:paddingVertical="16dp" android:clickable="true"
                    android:focusable="true" android:minHeight="48dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
