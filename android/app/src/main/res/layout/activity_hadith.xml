<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hadithRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader
            android:id="@+id/utilitiesHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/hadithSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="22dp"
            android:paddingHorizontal="17dp"
            android:background="@drawable/calendar_card"
            android:hint="Cari hadis atau topik…"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:textSize="16sp"
            android:textColor="@color/pine"
            android:textColorHint="#52665F"
            android:contentDescription="Cari hadis atau topik"
            android:minHeight="56dp" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:scrollbars="none"
            android:paddingHorizontal="18dp"
            android:paddingVertical="8dp">
            <LinearLayout
                android:id="@+id/hadithTabs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/screen_inset"
            android:paddingBottom="118dp"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/hadithHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hadith_hero"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:contentDescription="Baca hadis Berkata baik. HR. Bukhari 6018 dan Muslim 47.">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PESAN KEBAIKAN"
                        android:textColor="#D5BD87"
                        android:textSize="14sp"
                        android:letterSpacing="0.16" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="19dp"
                        android:text="فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:gravity="center"
                        android:textDirection="rtl" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="“Hendaklah ia berkata baik\natau diam.”"
                        android:textColor="@color/white"
                        android:textSize="19sp"
                        android:gravity="center"
                        android:fontFamily="serif"
                        android:lineSpacingExtra="5dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="17dp"
                        android:text="HR. Bukhari 6018 · Muslim 47"
                        android:textColor="#BBCFC2"
                        android:textSize="14sp"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Baca dan simpan hadis  →"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/hadithCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilihan hadis"
                    android:textColor="@color/pine"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="6dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Koleksi ringkas offline · terjemahan makna"
                    android:textColor="#52665F"
                    android:textSize="14sp"
                    android:layout_marginBottom="14dp" />
                <TextView
                    android:id="@+id/hadithEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Belum ada hadis yang cocok.\nCoba kata lain atau kategori Semua."
                    android:textColor="#52665F"
                    android:textSize="14sp"
                    android:lineSpacingExtra="7dp"
                    android:visibility="gone"
                    android:minHeight="120dp"
                    android:accessibilityLiveRegion="polite" />
                <LinearLayout
                    android:id="@+id/hadithList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
