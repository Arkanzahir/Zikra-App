<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quranCatalogAudio" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="64dp" android:visibility="gone" android:background="@color/concept_ivory">
    <LinearLayout android:id="@+id/catalogAudioCard" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/reference_paper_action">
        <LinearLayout android:id="@+id/catalogAudioRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/catalogAudioOpen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
                android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                <ImageView android:layout_width="40dp" android:layout_height="44dp" android:src="@drawable/reference_quran_book" android:background="@drawable/bg_pine" android:padding="4dp" android:importantForAccessibility="no"/>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:id="@+id/catalogAudioTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text"/>
                    <TextView android:id="@+id/catalogAudioReciter" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/onboarding_muted"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:id="@+id/catalogAudioControls" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/catalogAudioPrevious" style="@style/QuranAudioControl" android:src="@drawable/audio_previous" android:contentDescription="@string/audio_previous"/>
                <ImageButton android:id="@+id/catalogAudioPlay" style="@style/QuranAudioControl" android:src="@drawable/audio_play" android:background="@drawable/bg_mushaf_play" android:tint="@color/white" android:contentDescription="@string/audio_play"/>
                <ImageButton android:id="@+id/catalogAudioNext" style="@style/QuranAudioControl" android:src="@drawable/audio_next" android:contentDescription="@string/audio_next"/>
            </LinearLayout>
        </LinearLayout>
        <ProgressBar android:id="@+id/catalogAudioProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="4dp" android:progressTint="@color/pine" android:progressBackgroundTint="@color/studio_tint_dae9e0" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/catalogAudioTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/onboarding_muted" android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>
