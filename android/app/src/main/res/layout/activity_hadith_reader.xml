<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/daily_paper">
    <com.zikra.app.ui.FeatureHeader android:id="@+id/utilitiesHeader"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:id="@+id/hadithReaderKind" style="@style/HadithLabel"
                android:text="@string/hadith_loading" />
            <TextView android:id="@+id/hadithReaderBook" style="@style/DailyCaption"
                android:textSize="13sp" android:textColor="@color/hadith_secondary" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/dailyReaderTitle" style="@style/DailyHeading"
                android:layout_marginTop="8dp" android:textSize="25sp" />
            <TextView android:id="@+id/dailyReaderSource" style="@style/DailyCaption"
                android:textColor="@color/hadith_secondary" android:textSize="12sp" android:layout_marginTop="8dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/daily_line" android:layout_marginVertical="20dp" />
            <TextView style="@style/HadithLabel" android:text="@string/hadith_refined_arabic" />
            <TextView android:id="@+id/dailyReaderArabic" style="@style/DailyText"
                android:layout_marginTop="12dp" android:layout_marginBottom="24dp"
                android:textSize="28sp" android:fontFamily="serif" android:includeFontPadding="true"
                android:textDirection="rtl" android:gravity="end" android:textAlignment="viewEnd" android:lineSpacingExtra="7dp"
                android:textIsSelectable="true" />
            <TextView android:id="@+id/hadithReaderMeaningLabel" style="@style/HadithLabel"
                android:text="@string/hadith_refined_translation" />
            <TextView android:id="@+id/dailyReaderMeaning" style="@style/DailyText"
                android:layout_marginTop="10dp" android:textSize="15sp" android:lineSpacingExtra="5dp"
                android:textIsSelectable="true" />
            <TextView android:id="@+id/hadithReaderNote" style="@style/DailyCaption"
                android:textColor="@color/hadith_secondary" android:layout_marginTop="20dp"
                android:padding="12dp" android:background="@drawable/daily_mint_card" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/daily_line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="8dp"
        android:background="@color/daily_white" android:baselineAligned="false">
        <TextView android:id="@+id/dailyReaderSave" style="@style/DailyButton"
            android:layout_width="0dp" android:layout_weight="1" android:paddingHorizontal="8dp"
            android:background="@drawable/reading_pine_card" android:textColor="@android:color/white"
            android:text="@string/daily_reader_bookmark" android:textSize="12sp" />
        <TextView android:id="@+id/dailyReaderCopy" style="@style/DailyButton"
            android:layout_width="0dp" android:layout_weight="1" android:paddingHorizontal="8dp"
            android:background="@android:color/transparent" android:text="@string/daily_reader_copy" android:textSize="12sp" />
        <TextView android:id="@+id/dailyReaderShare" style="@style/DailyButton"
            android:layout_width="0dp" android:layout_weight="1" android:paddingHorizontal="8dp"
            android:background="@android:color/transparent" android:text="@string/daily_reader_share" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
