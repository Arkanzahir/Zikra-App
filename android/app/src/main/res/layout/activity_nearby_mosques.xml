<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mosquesRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/onboarding_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader android:id="@+id/mosquesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temukan tempat\nuntuk singgah." android:textColor="@color/pine" android:textSize="27sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Masjid dan tempat ibadah Muslim dalam radius 3 km dari lokasi pilihanmu." android:textSize="15sp" android:lineSpacingExtra="4dp" android:textColor="@color/onboarding_muted" />
                <Button android:id="@+id/mosquesLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="8dp" android:text="Ubah lokasi" android:textAllCaps="false" android:textColor="@color/pine" android:background="@drawable/bg_location_outline" android:stateListAnimator="@null" android:elevation="0dp" android:padding="12dp" android:textSize="14sp" />
                <Button android:id="@+id/mosquesProvider" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Pilih sumber pencarian" android:textAllCaps="false" android:textColor="@color/pine" android:visibility="gone" />
                <Button android:id="@+id/mosquesRefresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:background="@drawable/bg_pine" android:padding="12dp" android:text="Cari masjid" android:textAllCaps="false" android:textColor="@color/white" />
                <TextView android:id="@+id/mosquesStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textSize="14sp" android:textColor="@color/pine" android:lineSpacingExtra="4dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/mosquesMapToggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Lihat peta" android:textAllCaps="false" android:textColor="@color/pine" android:background="@drawable/bg_location_outline" android:stateListAnimator="@null" android:elevation="0dp" android:padding="12dp" android:layout_marginTop="8dp" android:textSize="14sp" />
                <FrameLayout android:id="@+id/mosquesMap" android:layout_width="match_parent" android:layout_height="280dp" android:visibility="gone" />
                <TextView android:id="@+id/mosquesMapStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:textColor="@color/onboarding_muted" android:lineSpacingExtra="4dp" android:visibility="gone" />
                <TextView android:id="@+id/mosquesAttribution" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="Sumber pencarian" android:textSize="12sp" android:textColor="@color/onboarding_muted" android:clickable="true" android:focusable="true" />
                <LinearLayout android:id="@+id/mosquesResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" />
                <Button android:id="@+id/mosquesExternal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Cari juga di Google Maps ↗" android:textAllCaps="false" android:textColor="@color/pine" android:background="@drawable/bg_location_outline" android:stateListAnimator="@null" android:elevation="0dp" android:padding="12dp" android:layout_marginTop="8dp" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jarak berupa garis lurus, bukan jarak perjalanan. Jam jamaah, fasilitas, dan kondisi buka perlu dikonfirmasi ke masjid." android:textSize="12sp" android:textColor="@color/onboarding_muted" android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>