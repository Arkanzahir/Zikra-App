<?xml version='1.0' encoding='utf-8'?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:paddingHorizontal="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/white">
        <ImageButton
            android:id="@+id/toolbarBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:tint="#243144"
            android:padding="13dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="4dp">
            <TextView
                android:id="@+id/protectorToolbarTitle"
                style="@style/ProtectorHeading"
                android:text="Zikra Protector"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/protectorToolbarSubtitle"
                style="@style/ProtectorBody"
                android:text="Info BMKG · Sukolilo, Surabaya"
                android:textSize="10sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/protectorRefresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/protector_ic_refresh"
            android:tint="#3569F3"
            android:padding="14dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Muat ulang data BMKG" />
    </LinearLayout>
</merge>
