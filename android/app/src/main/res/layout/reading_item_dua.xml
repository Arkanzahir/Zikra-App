<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dua_entry_background">
    <LinearLayout android:id="@+id/duaExpand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:minHeight="88dp"
        android:foreground="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <ImageView android:id="@+id/duaRowIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/dua_icon_surface"
            android:src="@drawable/ic_book"
            android:tint="@color/daily_ink"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">
            <TextView android:id="@+id/duaRowCategory"
                style="@style/DailyCaption"
                android:textColor="@color/dua_bronze"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.09" />
            <TextView android:id="@+id/duaTitle"
                style="@style/DailyHeading"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />
            <TextView android:id="@+id/duaSubtitle"
                style="@style/DailyCaption"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <ImageView android:id="@+id/duaChevron"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_back"
            android:tint="@color/daily_ink"
            android:rotation="180"
            android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:id="@+id/duaContent" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingHorizontal="16dp" android:paddingBottom="20dp" android:visibility="gone">
        <TextView android:id="@+id/duaArabic" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="16dp" android:layout_marginBottom="20dp"
            android:background="@drawable/dua_arabic_surface" android:textDirection="rtl"
            android:textAlignment="viewEnd" android:gravity="end" android:textColor="@color/daily_ink"
            android:textSize="30sp" android:lineSpacingExtra="10dp" android:textIsSelectable="true" />
        <TextView android:id="@+id/duaLatinLabel" style="@style/DuaSectionLabel" android:text="@string/dua_latin_label" />
        <TextView android:id="@+id/duaLatin" style="@style/DailyText" android:textSize="13sp"
            android:textColor="@color/dua_text_secondary" android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" android:textIsSelectable="true" />
        <TextView style="@style/DuaSectionLabel" android:text="@string/dua_meaning_label" />
        <TextView android:id="@+id/duaTranslation" style="@style/DailyText" android:textSize="14sp"
            android:textColor="@color/daily_ink" android:layout_marginTop="6dp" android:textIsSelectable="true" />
        <TextView android:id="@+id/duaSource" style="@style/DailyCaption" android:textSize="11sp"
            android:textColor="@color/dua_text_secondary" android:layout_marginTop="12dp" />
        <Button android:id="@+id/duaListen" style="@style/ReadingButton" android:layout_marginTop="16dp"
            android:text="@string/dua_library_tts" android:enabled="false" android:background="@drawable/reading_pine_card"
            android:textSize="13sp" android:layout_height="wrap_content" android:minHeight="48dp"
            android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:drawablePadding="8dp"
            android:drawableStart="@drawable/reading_audio_speaker" android:drawableTint="@android:color/white" />
        <TextView android:id="@+id/duaSourceToggle" style="@style/DailyText" android:layout_width="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" android:textSize="12sp" android:textStyle="bold"
            android:text="@string/dua_source_show" android:paddingHorizontal="4dp"
            android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/duaSourceDetails" style="@style/DailyCaption" android:textSize="12sp"
            android:textColor="@color/dua_text_secondary" android:paddingBottom="4dp"
            android:textIsSelectable="true" android:visibility="gone" />
    </LinearLayout>
    <View android:id="@+id/duaRowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="16dp"
        android:background="@color/daily_line" />
</LinearLayout>
