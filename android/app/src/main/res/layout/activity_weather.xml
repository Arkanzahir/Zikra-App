<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_surface">
    <include
        layout="@layout/protector_toolbar" />
    <ScrollView
        android:id="@+id/weatherScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/protector_screen_padding"
            android:paddingBottom="24dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/weather_hero_bg"
                android:clipToOutline="true">
                <com.zikra.app.safety.WeatherArtworkView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:gravity="center_horizontal">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/qibla_ic_location"
                            android:importantForAccessibility="no"
                            android:tint="@color/protector_cyan_ink" />
                        <TextView
                            style="@style/ProtectorHeading"
                            android:text="Lokasi pilihan"
                            android:id="@+id/weatherLocation"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textSize="12sp"
                            android:textColor="@color/protector_cyan_ink" />
                    </LinearLayout>
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Waktu prakiraan belum tersedia"
                        android:id="@+id/weatherDate"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="@color/app_ink_345c50"
                        android:layout_marginTop="5dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:id="@+id/weatherMetricsHeading">
                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:src="@drawable/weather_symbol_cloud"
                            android:importantForAccessibility="no"
                            android:id="@+id/weatherHeroIcon"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            style="@style/ProtectorHeading"
                            android:text="—°C"
                            android:id="@+id/weatherTemperature"
                            android:layout_width="wrap_content"
                            android:textSize="58sp"
                            android:textColor="@color/app_ink_174a5e"
                            android:fontFeatureSettings="tnum" />
                    </LinearLayout>
                    <TextView
                        style="@style/ProtectorHeading"
                        android:text="Memuat prakiraan…"
                        android:id="@+id/weatherDescription"
                        android:gravity="center"
                        android:textSize="17sp"
                        android:textColor="@color/protector_cyan_ink"
                        android:layout_marginTop="5dp" />
                    <TextView
                        style="@style/ProtectorBody"
                        android:text="Menghubungkan ke Open-Meteo"
                        android:id="@+id/weatherStatus"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="@color/app_ink_345c50"
                        android:layout_marginTop="6dp" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="20dp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#4088B7C5" />
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:src="@drawable/weather_ic_drop"
                                android:importantForAccessibility="no"
                                android:tint="@color/app_ink_316f83" />
                            <TextView
                                style="@style/ProtectorMetric"
                                android:text="—"
                                android:id="@+id/weatherHumidity"
                                android:textColor="@color/protector_cyan_ink"
                                android:layout_marginTop="7dp" />
                            <TextView
                                style="@style/ProtectorMetricCaption"
                                android:text="Kelembapan"
                                android:textColor="@color/app_ink_345c50"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:src="@drawable/weather_ic_wind"
                                android:importantForAccessibility="no"
                                android:tint="@color/app_ink_316f83" />
                            <TextView
                                style="@style/ProtectorMetric"
                                android:text="—"
                                android:id="@+id/weatherWind"
                                android:textColor="@color/protector_cyan_ink"
                                android:layout_marginTop="7dp" />
                            <TextView
                                style="@style/ProtectorMetricCaption"
                                android:text="Angin · km/jam"
                                android:textColor="@color/app_ink_345c50"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:gravity="center_horizontal">
                            <ImageView
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:src="@drawable/ic_compass"
                                android:importantForAccessibility="no"
                                android:tint="@color/app_ink_316f83" />
                            <TextView
                                style="@style/ProtectorMetric"
                                android:text="—"
                                android:id="@+id/weatherDirection"
                                android:textColor="@color/protector_cyan_ink"
                                android:layout_marginTop="7dp" />
                            <TextView
                                style="@style/ProtectorMetricCaption"
                                android:text="Arah angin"
                                android:textColor="@color/app_ink_345c50"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/weather_chart_bg"
                android:padding="16dp"
                android:layout_marginTop="16dp">
                <TextView
                    style="@style/ProtectorHeading"
                    android:text="Temperatur"
                    android:textSize="14sp"
                    android:textColor="@color/protector_cyan_ink" />
                <TextView
                    style="@style/ProtectorBody"
                    android:text="Per slot prakiraan · WIB"
                    android:textSize="12sp"
                    android:textColor="@color/app_ink_466456"
                    android:layout_marginTop="4dp" />
                <com.zikra.app.safety.TemperatureChartView
                    android:id="@+id/weatherChart"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
            <TextView
                style="@style/ProtectorHeading"
                android:text="Prakiraan cuaca"
                android:textSize="16sp"
                android:layout_marginTop="22dp" />
            <TextView
                style="@style/ProtectorBody"
                android:text="Waktu setempat · Asia/Jakarta"
                android:textSize="12sp"
                android:layout_marginTop="5dp" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:scrollbars="none"
                android:clipToPadding="false">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/weatherForecastList" />
            </HorizontalScrollView>
            <TextView
                style="@style/ProtectorBody"
                android:text="Prakiraan akan muncul saat data prakiraan tersedia."
                android:id="@+id/weatherEmptyForecast"
                android:layout_marginTop="12dp"
                android:textSize="12sp"
                android:background="@drawable/protector_soft_card"
                android:padding="14dp" />
            <TextView
                style="@style/ProtectorBody"
                android:text="Prakiraan model: Open-Meteo · CC BY 4.0 ↗"
                android:id="@+id/weatherSource"
                android:textSize="12sp"
                android:minHeight="48dp"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
