<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="10dp"
    android:paddingHorizontal="14dp"
    android:background="@drawable/reading_white_card"
    android:foreground="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true">
    <TextView
        android:id="@+id/surahListNumber"
        android:layout_width="37dp"
        android:layout_height="37dp"
        android:background="@drawable/reading_number"
        android:gravity="center"
        android:textColor="#557A65"
        android:textSize="12sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="13dp">
        <TextView
            android:id="@+id/surahListName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pine"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/surahListInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#92A19A"
            android:textSize="9sp"
            android:layout_marginTop="5dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/surahListArabic"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textDirection="rtl"
        android:textColor="#597E6B"
        android:textSize="20sp" />
</LinearLayout>
