<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:foreground="?android:attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_marginBottom="8dp">
    <LinearLayout
        android:id="@+id/surahListContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="2dp"
        android:padding="14dp">
        <TextView
            android:id="@+id/surahListNumber"
            android:layout_width="wrap_content"
            android:minWidth="36dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:padding="3dp"
            android:background="@drawable/reading_surah_number"
            android:gravity="center"
            android:textColor="@color/studio_tint_7f6739"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/surahListNames"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:id="@+id/surahListName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pine"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/surahListInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/studio_tint_52685d"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/surahListArabic"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textDirection="rtl"
            android:textColor="@color/pine"
            android:textSize="23sp" />
    </LinearLayout>
    <View
        android:id="@+id/surahListDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/studio_tint_ebeee9"
        android:visibility="gone" />
</LinearLayout>
