<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:foreground="?android:attr/selectableItemBackground" android:focusable="true" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="12dp" android:paddingHorizontal="2dp">
        <TextView android:id="@+id/surahListNumber" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/reading_surah_number" android:gravity="center" android:textColor="#7F6739" android:textSize="11sp" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/surahListName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/pine" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/surahListInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp" android:textColor="#63766C" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/surahListArabic" android:layout_width="90dp" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:gravity="end" android:textDirection="rtl" android:textColor="@color/pine" android:textSize="23sp" />
    </LinearLayout>
    <View android:id="@+id/surahListDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#EBEEE9" />
</LinearLayout>
