<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aiRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ai_background">
    <LinearLayout
        android:id="@+id/aiPage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/dock_reserved">
        <ScrollView
            android:id="@+id/aiScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_inset"
                android:paddingTop="10dp"
                android:paddingBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical">
                    <ImageButton
                        android:id="@+id/toolbarBack"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:padding="13dp"
                        android:background="@drawable/ai_circle"
                        android:src="@drawable/ic_back"
                        android:tint="#463A56"
                        android:contentDescription="Kembali" />
                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Zikra AI"
                        android:textColor="@color/assistant_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/aiClear"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:background="@drawable/ai_circle"
                        android:padding="13dp"
                        android:src="@drawable/ai_reset"
                        android:contentDescription="Hapus percakapan" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/ai_circle"
                        android:text="A"
                        android:textSize="17sp"
                        android:textColor="@color/assistant_accent"
                        android:textStyle="bold"
                        android:gravity="center" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assalamualaikum, Arkan"
                            android:textColor="#766D82"
                            android:textSize="11sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Ada yang ingin kamu pelajari?"
                            android:textColor="@color/assistant_text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:padding="5dp"
                        android:src="@drawable/ic_spark"
                        android:tint="#9B79D0"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Bagaimana saya\nbisa membantumu?"
                    android:textColor="@color/assistant_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/ai_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="✦  Pendamping offline"
                    android:textColor="#70558F"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <LinearLayout
                        android:id="@+id/aiChatTile"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="132dp"
                        android:background="@drawable/ai_tile"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Tulis pesan untuk pendamping offline">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/ai_pill"
                            android:padding="6dp"
                            android:src="@drawable/ic_spark"
                            android:tint="#9B79D0"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Mulai ngobrol"
                            android:textColor="@color/assistant_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Susun langkah kecil\nuntuk hari ini"
                            android:textColor="#8D8299"
                            android:textSize="10sp"
                            android:lineSpacingExtra="3dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Tulis pesan  →"
                            android:textColor="@color/assistant_accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/aiVoiceTile"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="132dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/ai_tile"
                        android:padding="16dp"
                        android:orientation="vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Masukkan pesan dengan suara">
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/ai_pill"
                            android:padding="7dp"
                            android:src="@drawable/ic_mic"
                            android:tint="#9B79D0"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Ceritakan saja"
                            android:textColor="@color/assistant_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Ubah suaramu\nmenjadi pesan"
                            android:textColor="#8D8299"
                            android:textSize="10sp"
                            android:lineSpacingExtra="3dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Gunakan suara  →"
                            android:textColor="@color/assistant_accent"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/aiVoicePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ai_tile"
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">
                    <com.zikra.app.assistant.AssistantOrbView
                        android:id="@+id/aiOrb"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/aiVoiceStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ceritakan targetmu hari ini"
                        android:gravity="center"
                        android:textColor="#70558F"
                        android:textSize="12sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Mulai dari topik kecil"
                    android:textColor="@color/assistant_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/aiTopicStudy"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:background="@drawable/ai_pill"
                        android:text="Belajar"
                        android:gravity="center"
                        android:textColor="#70558F"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/aiTopicPrayer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ai_tile"
                        android:text="Ibadah"
                        android:gravity="center"
                        android:textColor="#70558F"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/aiTopicHifz"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ai_tile"
                        android:text="Hafalan"
                        android:gravity="center"
                        android:textColor="#70558F"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/aiChatThread"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Jawaban berbasis panduan lokal, bukan AI generatif.\nPercakapan tersimpan di perangkat ini."
                    android:textColor="#8E8199"
                    android:textSize="9sp"
                    android:lineSpacingExtra="3dp" />
                <TextView
                    android:id="@+id/aiOpenStudy"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Lanjutkan ke Study Hub  →"
                    android:textColor="@color/assistant_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:id="@+id/aiComposer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/ai_tile"
            android:padding="6dp"
            android:gravity="bottom"
            android:layout_marginHorizontal="@dimen/screen_inset"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">
            <ImageButton
                android:id="@+id/aiVoice"
                android:layout_width="42dp"
                android:layout_height="48dp"
                android:padding="13dp"
                android:src="@drawable/ic_mic"
                android:tint="#9677B8"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Input suara" />
            <EditText
                android:id="@+id/aiInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:paddingVertical="12dp"
                android:background="@null"
                android:hint="Tulis pesanmu…"
                android:textColor="@color/assistant_text"
                android:textColorHint="#968B9F"
                android:textSize="12sp"
                android:maxLength="500"
                android:maxLines="4"
                android:inputType="textCapSentences|textMultiLine"
                android:gravity="top|start" />
            <ImageButton
                android:id="@+id/aiSend"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="3dp"
                android:padding="10dp"
                android:background="@drawable/ai_primary"
                android:src="@drawable/ai_send"
                android:contentDescription="Kirim pesan" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
