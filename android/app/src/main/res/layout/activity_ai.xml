<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/aiRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ai_refresh_surface">
  <LinearLayout android:id="@+id/aiPage" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingBottom="64dp" android:orientation="vertical">
    <LinearLayout android:id="@+id/utilitiesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:gravity="center_vertical">
      <ImageButton android:id="@+id/toolbarBack" style="@style/AiIconButton" android:src="@drawable/ai_refresh_history" android:background="@drawable/ai_refresh_suggestion" android:contentDescription="@string/ai_refresh_history" />
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
        <TextView android:id="@+id/detailTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_refresh_title" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ai_refresh_ink" android:accessibilityHeading="true" />
        <TextView android:id="@+id/aiMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="120dp" android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:text="@string/ai_balanced_initial_mode" android:textSize="12sp" android:textColor="@color/ai_refresh_muted" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackgroundBorderless" />
      </LinearLayout>
      <ImageButton android:id="@+id/aiClear" style="@style/AiIconButton" android:src="@drawable/ai_refresh_new" android:contentDescription="@string/ai_refresh_new" />
    </LinearLayout>
    <TextView android:id="@+id/aiNetworkNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="6dp" android:textSize="12sp" android:textColor="@color/ai_refresh_muted" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <ScrollView android:id="@+id/aiScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:paddingBottom="16dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/aiWelcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="36dp" android:paddingBottom="16dp" android:orientation="vertical">
          <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_marginBottom="22dp" android:padding="10dp" android:src="@drawable/ai_balanced_sparkles" android:background="@drawable/ai_balanced_emblem" android:importantForAccessibility="no" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_balanced_welcome_first" android:textColor="@color/ai_refresh_muted" android:textSize="30sp" android:letterSpacing="-0.025" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_balanced_welcome_second" android:textColor="@color/ai_refresh_accent" android:textSize="30sp" android:letterSpacing="-0.025" android:accessibilityHeading="true" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="24dp" android:text="@string/ai_balanced_caption" android:textColor="@color/ai_refresh_muted" android:textSize="14sp" android:lineSpacingExtra="3dp" />
          <LinearLayout android:id="@+id/aiEntryActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
              <TextView android:id="@+id/aiChatTile" style="@style/AiPrompt" android:text="@string/ai_refresh_material" android:drawableStart="@drawable/ai_balanced_book" />
              <Space android:layout_width="8dp" android:layout_height="1dp" />
              <TextView android:id="@+id/aiTopicStudy" style="@style/AiPrompt" android:text="@string/ai_refresh_plan" android:drawableStart="@drawable/ai_balanced_calendar" android:background="@drawable/ai_balanced_soft" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
              <TextView android:id="@+id/aiTopicAttachment" style="@style/AiPrompt" android:text="@string/ai_balanced_attachment" android:drawableStart="@drawable/ai_balanced_file" />
              <Space android:layout_width="8dp" android:layout_height="1dp" />
              <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
                <TextView android:id="@+id/aiTopicImage" style="@style/AiPrompt" android:layout_width="match_parent" android:layout_weight="0" android:text="@string/ai_images_create" android:drawableStart="@drawable/ai_balanced_image" android:visibility="gone" />
                <TextView android:id="@+id/aiTopicHifz" style="@style/AiPrompt" android:layout_width="match_parent" android:layout_weight="0" android:text="@string/ai_balanced_hifz" android:drawableStart="@drawable/ai_balanced_book" />
              </FrameLayout>
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/aiChatThread" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:orientation="vertical" />
        <TextView android:id="@+id/aiRequestStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp" android:textSize="14sp" android:textColor="@color/ai_refresh_muted" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/aiRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/concept_ai_retry" android:textAllCaps="false" android:visibility="gone" />
      </LinearLayout>
    </ScrollView>
    <TextView android:id="@+id/aiOfflineNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="40dp" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:layout_marginHorizontal="14dp" android:layout_marginBottom="8dp" android:background="@drawable/ai_balanced_soft" android:text="@string/ai_balanced_offline" android:textColor="@color/ai_refresh_muted" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/aiVoiceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="24dp" android:textSize="12sp" android:textColor="@color/ai_refresh_muted" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/aiComposer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:layout_marginBottom="12dp" android:padding="8dp" android:orientation="vertical" android:background="@drawable/ai_refresh_input">
      <LinearLayout android:id="@+id/aiAttachmentDraft" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
      <TextView android:id="@+id/aiImageMode" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:gravity="center_vertical" android:background="@drawable/ai_balanced_soft" android:text="@string/ai_images_mode" android:textSize="12sp" android:textColor="@color/ai_refresh_ink" android:clickable="true" android:focusable="true" android:visibility="gone" />
      <EditText android:id="@+id/aiInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="10dp" android:paddingVertical="8dp" android:background="@null" android:hint="@string/ai_balanced_input" android:textSize="16sp" android:textColor="@color/ai_refresh_ink" android:textColorHint="@color/ai_refresh_muted" android:maxLength="500" android:maxLines="4" android:inputType="textCapSentences|textMultiLine" android:gravity="top|start" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:baselineAligned="false" android:paddingVertical="2dp">
        <ImageButton android:id="@+id/aiAttach" style="@style/AiIconButton" android:src="@drawable/ai_refresh_plus" android:contentDescription="@string/ai_refresh_attach" />
        <TextView android:id="@+id/aiTools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:text="@string/ai_balanced_tools" android:textSize="13sp" android:textColor="@color/ai_refresh_muted" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackgroundBorderless" />
        <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
        <ImageButton android:id="@+id/aiVoice" style="@style/AiIconButton" android:src="@drawable/ic_mic" android:contentDescription="@string/ai_balanced_voice" />
        <ImageButton android:id="@+id/aiSend" style="@style/AiIconButton" android:src="@drawable/ai_send" android:tint="@color/ai_refresh_on_accent" android:background="@drawable/ai_refresh_primary" android:contentDescription="@string/ai_balanced_send" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
