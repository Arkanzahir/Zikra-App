<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/protector_ivory">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp">
        <TextView style="@style/ProtectorReferenceAction" android:id="@+id/toolbarBack" android:text="@string/protector_ref_toolbar_back_text" android:contentDescription="@string/protector_back" android:background="@android:color/transparent" android:textSize="30sp" />
        <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeTitle" android:text="@string/protector_map_title" android:textSize="19sp" android:textStyle="bold" android:gravity="center" android:layout_weight="1" android:layout_width="0dp" />
        <TextView style="@style/ProtectorReferenceAction" android:id="@+id/protectorRefresh" android:text="@string/protector_ref_protector_refresh_text" android:contentDescription="@string/protector_refresh" android:background="@android:color/transparent" android:textSize="28sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:paddingBottom="6dp">
        <TextView style="@style/ProtectorReferenceAction" android:id="@+id/quakeTabEpicenter" android:text="@string/protector_epicenter" android:layout_weight="1" android:layout_width="0dp" />
        <TextView style="@style/ProtectorReferenceAction" android:id="@+id/quakeTabShaking" android:text="@string/protector_shaking" android:layout_weight="1" android:layout_width="0dp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="180dp">
        <com.zikra.app.safety.EarthquakeMapView android:id="@+id/quakeMap" android:layout_width="match_parent" android:layout_height="match_parent" />
        <FrameLayout android:id="@+id/quakeShakingPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/protector_ivory" android:visibility="gone">
            <ImageView android:id="@+id/quakeShakingImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:contentDescription="@string/protector_shakemap_description" />
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeShakingStatus" android:text="@string/protector_shakemap_loading" android:textSize="13sp" android:layout_gravity="center" android:gravity="center" android:padding="24dp" />
        </FrameLayout>
    </FrameLayout>
    <ScrollView android:id="@+id/quakeSheet" android:layout_width="match_parent" android:layout_height="300dp" android:background="@drawable/protector_reference_sheet" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeHeading" android:text="@string/protector_quake_heading" android:textSize="19sp" android:textStyle="bold" />
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeArea" android:text="@string/protector_ref_quake_area_text" android:textSize="12sp" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false" android:layout_marginTop="10dp" android:layout_marginBottom="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView style="@style/ProtectorReferenceText" android:id="@+id/detailMetric0" android:text="@string/protector_magnitude_label" android:textSize="11sp" android:textColor="@color/protector_ref_color_596461" />
                    <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeMagnitude" android:text="@string/protector_placeholder" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="5dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView style="@style/ProtectorReferenceText" android:id="@+id/detailMetric1" android:text="@string/protector_depth_label" android:textSize="11sp" android:textColor="@color/protector_ref_color_596461" />
                    <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeDepth" android:text="@string/protector_placeholder" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="5dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView style="@style/ProtectorReferenceText" android:id="@+id/detailMetric2" android:text="@string/protector_time_label" android:textSize="11sp" android:textColor="@color/protector_ref_color_596461" />
                    <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeClock" android:text="@string/protector_placeholder" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="5dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeTime" android:text="@string/protector_ref_quake_time_text" android:textSize="11sp" />
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeFelt" android:text="@string/protector_ref_quake_felt_text" android:textSize="12sp" android:layout_marginTop="8dp" />
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakePotential" android:text="@string/protector_ref_quake_potential_text" android:textSize="12sp" android:layout_marginTop="8dp" />
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeCoordinates" android:text="@string/protector_ref_quake_coordinates_text" android:textSize="11sp" android:layout_marginTop="8dp" />
            <TextView style="@style/ProtectorReferenceText" android:id="@+id/quakeStatus" android:text="@string/protector_ref_quake_status_text" android:textSize="11sp" android:layout_marginTop="8dp" />
            <TextView style="@style/ProtectorReferenceAction" android:id="@+id/quakeSource" android:text="@string/protector_bmkg_source" android:layout_marginTop="12dp" android:layout_gravity="fill_horizontal" android:textColor="@color/protector_ref_color_ffffff" android:background="@drawable/protector_reference_selected" android:layout_width="match_parent" />
            <TextView style="@style/ProtectorReferenceAction" android:id="@+id/quakeOpenMap" android:text="@string/protector_ref_quake_open_map_text" android:layout_marginTop="4dp" android:background="@android:color/transparent" android:layout_gravity="center" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>