<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="7dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/prayer_bg_row">
    <ImageView
        android:id="@+id/prayerRowIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_sun"
        android:tint="@color/sage"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/prayerRowName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textColor="#476650"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/prayerRowTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:textColor="#31583F"
        android:textSize="12sp" />
    <ImageButton
        android:id="@+id/prayerRowBell"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_bell"
        android:tint="@color/sage"
        android:contentDescription="Ubah preferensi pengingat" />
</LinearLayout>
