<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/calendarRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/refined_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader android:id="@+id/utilitiesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="16dp" android:paddingBottom="28dp" android:clipToPadding="false" android:paddingTop="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/refined_card" android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:minHeight="54dp">
                        <ImageButton android:id="@+id/calendarPrev" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:padding="15dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:tint="@color/refined_ink" android:contentDescription="Bulan sebelumnya" />
                        <TextView android:id="@+id/calendarMonth" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:breakStrategy="simple" android:text="Kalender" android:gravity="center" android:textColor="@color/refined_ink" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
                        <ImageButton android:id="@+id/calendarNext" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:rotation="180" android:padding="15dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:tint="@color/refined_ink" android:contentDescription="Bulan berikutnya" />
                    </LinearLayout>
                    <TextView android:id="@+id/calendarGregorian" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="@color/refined_muted" android:layout_marginBottom="12dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <LinearLayout android:id="@+id/calendarWeekdays" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:minHeight="36dp" />
                        <GridLayout android:id="@+id/calendarGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="7" android:alignmentMode="alignMargins" android:useDefaultMargins="false" />
                    </LinearLayout>
                    <TextView android:id="@+id/calendarSelection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="16dp" android:background="@drawable/refined_mint_card" android:textColor="@color/refined_ink" android:textSize="14sp" android:lineSpacingExtra="4dp" android:accessibilityLiveRegion="polite" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hari istimewa berikutnya" android:textColor="@color/refined_ink" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="25dp" android:layout_marginBottom="14dp" />
                <LinearLayout android:id="@+id/calendarEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Perkiraan kalender Umm al-Qura, bukan penetapan hari raya. Awal bulan dan hari besar mengikuti keputusan otoritas setempat; tanggal dapat berbeda." android:textColor="@color/refined_muted" android:textSize="14sp" android:lineSpacingExtra="5dp" android:padding="8dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_calendar_note" android:textColor="@color/refined_muted" android:textSize="12sp" android:paddingVertical="12dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>