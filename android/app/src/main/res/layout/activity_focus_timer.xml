<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">
    <com.zikra.app.ui.FeatureHeader android:id="@+id/focusHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/focusContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">
            <TextView android:id="@+id/focusTask" style="@style/NearbySection" android:textSize="22sp" />
            <TextView style="@style/NearbyCaption" android:layout_marginTop="8dp" android:text="@string/focus_intro" />
            <RadioGroup
                android:id="@+id/focusDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_nearby_panel"
                android:padding="4dp"
                android:layout_marginTop="18dp">
                <RadioButton android:id="@+id/focusShort" style="@style/NearbyTab" android:text="25 / 5 menit" />
                <RadioButton android:id="@+id/focusLong" style="@style/NearbyTab" android:text="50 / 10 menit" />
            </RadioGroup>
            <LinearLayout
                android:id="@+id/focusStage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="14dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/studio_focus_stage"
                android:padding="20dp">
                <TextView
                    android:id="@+id/focusPhase"
                    style="@style/NearbyCaption"
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:letterSpacing="0.08"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/focusTime"
                    android:layout_width="240dp"
                    android:layout_height="76dp"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:textColor="@color/pine"
                    android:gravity="center"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="22sp"
                    android:autoSizeMaxTextSize="56sp"
                    android:autoSizeStepGranularity="2sp" />
                <TextView
                    android:id="@+id/focusTotal"
                    style="@style/NearbyCaption"
                    android:layout_width="match_parent"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:text="@string/focus_remaining" />
                <com.zikra.app.ui.FocusGardenView
                    android:id="@+id/focusGarden"
                    android:layout_width="match_parent"
                    android:layout_height="194dp"
                    android:layout_marginTop="12dp"
                    android:importantForAccessibility="no" />
                <ProgressBar
                    android:id="@+id/focusProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="104dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="10dp"
                    android:max="1000"
                    android:progressTint="@color/pine"
                    android:progressBackgroundTint="@color/studio_tint_d0e0d6"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <Button
                android:id="@+id/focusPlay"
                style="@style/NearbyPrimary"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/audio_play"
                android:drawableTint="@color/white"
                android:drawablePadding="10dp"
                android:text="@string/focus_start" />
            <Button
                android:id="@+id/focusReset"
                style="@style/NearbyButton"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginTop="4dp"
                android:text="@string/focus_reset" />
            <Button
                android:id="@+id/focusNotificationSettings"
                style="@style/NearbyButton"
                android:layout_marginTop="8dp"
                android:text="Atur notifikasi"
                android:visibility="gone" />
            <TextView android:id="@+id/focusHint" style="@style/NearbyCaption" android:gravity="center" android:layout_marginTop="6dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
