<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pine"
    android:paddingHorizontal="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/onboardBack"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:padding="14dp"
            android:contentDescription="Kembali ke langkah sebelumnya" />
        <TextView
            android:id="@+id/onboardWordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="zikra."
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center" />
        <Button
            android:id="@+id/onboardSkip"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="Lewati"
            android:textAllCaps="false"
            android:textColor="#C4D8D0"
            android:textSize="12sp"
            android:padding="0dp" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/onboardScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">
            <LinearLayout
                android:id="@+id/onboardWelcome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ILMU · IMAN · KESEIMBANGAN"
                    android:textSize="9sp"
                    android:letterSpacing="0.16"
                    android:textColor="#C6AB78" />
                <com.zikra.app.discovery.LearningOrbitView
                    android:id="@+id/onboardOrbit"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/onboard_orbit_size"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:contentDescription="Orbit interaktif ilmu dan ibadah" />
                <TextView
                    style="@style/OnboardTitle"
                    android:text="Ilmu bertumbuh.\nIman terjaga."
                    android:textSize="30sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/white" />
                <TextView
                    style="@style/OnboardBody"
                    android:text="Ibadah lebih terarah. Belajar lebih tenang.\nMulai dari satu langkah kecil."
                    android:textColor="#C4D8D0" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/onboardIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="26dp">
                <TextView
                    style="@style/OnboardTitle"
                    android:text="Setiap tahap,\ncerita berbeda." />
                <TextView
                    style="@style/OnboardBody"
                    android:text="Kamu sedang di jenjang mana?\nMulai dengan pilihan yang paling sesuai."
                    android:layout_marginBottom="24dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        style="@style/OnboardLevelCard"
                        android:id="@+id/onboardLevelSmp"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="SMP">
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:padding="12dp"
                            android:src="@drawable/ic_book"
                            android:background="@drawable/onboard_icon_mint"
                            android:tint="@color/sage_active"
                            android:importantForAccessibility="no" />
                        <TextView style="@style/OnboardLevelTitle" android:text="SMP" />
                        <TextView style="@style/OnboardLevelCaption" android:text="Bangun kebiasaan" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/OnboardLevelCard"
                        android:id="@+id/onboardLevelSma"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:contentDescription="SMA atau SMK">
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:padding="12dp"
                            android:src="@drawable/home_ic_study"
                            android:background="@drawable/onboard_icon_gold"
                            android:tint="#AE7B32"
                            android:importantForAccessibility="no" />
                        <TextView style="@style/OnboardLevelTitle" android:text="SMA / SMK" />
                        <TextView style="@style/OnboardLevelCaption" android:text="Jelajahi potensi" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    style="@style/OnboardLevelCard"
                    android:id="@+id/onboardLevelUniversity"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp"
                    android:contentDescription="Mahasiswa">
                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:padding="13dp"
                        android:src="@drawable/ic_graduation"
                        android:background="@drawable/onboard_icon_violet"
                        android:tint="#8B6FA8"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">
                        <TextView style="@style/OnboardLevelTitle" android:layout_marginTop="0dp" android:text="Mahasiswa" />
                        <TextView style="@style/OnboardLevelCaption" android:text="Seimbangkan kuliah &amp; ibadah" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/home_ic_chevron"
                        android:tint="@color/sage"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <TextView
                    style="@style/OnboardBody"
                    android:text="Bisa diubah kapan saja melalui Profil."
                    android:textSize="11sp"
                    android:layout_marginTop="18dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/onboardTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="26dp">
                <TextView
                    style="@style/OnboardTitle"
                    android:text="Apa yang\nmembuatmu antusias?" />
                <TextView
                    style="@style/OnboardBody"
                    android:text="Pilih hingga 3 minat untuk profil belajarmu.\nKamu juga bisa melewati langkah ini."
                    android:layout_marginBottom="22dp" />
                <GridLayout
                    android:id="@+id/onboardInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins" />
                <TextView
                    android:id="@+id/onboardInterestCount"
                    style="@style/OnboardBody"
                    android:layout_marginTop="18dp"
                    android:text="0 dari 3 minat dipilih"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="polite" />
                <TextView
                    style="@style/OnboardBody"
                    android:text="Pilihanmu tersimpan di perangkat ini."
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <TextView
        android:id="@+id/onboardStep"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:text="●  ━  ○  ━  ○"
        android:textSize="10sp"
        android:textColor="#C4D8D0"
        android:gravity="center"
        android:importantForAccessibility="no" />
    <Button
        android:id="@+id/onboardContinue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/onboard_primary"
        android:backgroundTint="@null"
        android:stateListAnimator="@null"
        android:text="Mulai perjalanan"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textAllCaps="false" />
    <TextView
        android:id="@+id/onboardFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Tanpa akun · Mulai dengan caramu"
        android:textSize="10sp"
        android:textColor="#C4D8D0" />
</LinearLayout>
