<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/onboardRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/onboarding_paper" android:theme="@style/ZikraBrandLight">
    <LinearLayout android:id="@+id/onboardHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:paddingHorizontal="24dp" android:gravity="center_vertical" android:background="@color/onboarding_wall">
        <include layout="@layout/view_zikra_brand" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <Button android:id="@+id/onboardSkip" android:layout_width="wrap_content" android:minWidth="72dp" android:layout_height="wrap_content" android:minHeight="48dp" android:background="?android:attr/selectableItemBackground" android:text="Lewati" android:textAllCaps="false" android:textColor="@color/text" android:textSize="14sp" android:padding="0dp" />
    </LinearLayout>
    <ScrollView android:id="@+id/onboardScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:id="@+id/onboardStory" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/onboardIllustration" android:layout_width="match_parent" android:layout_height="280dp" android:scaleType="fitCenter" android:adjustViewBounds="false" android:background="@color/onboarding_wall" android:contentDescription="Pelajar berkacamata menulis di meja belajar." />
            <LinearLayout android:id="@+id/onboardCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="24dp" android:paddingTop="18dp" android:paddingBottom="18dp">
                <TextView android:id="@+id/onboardEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/onboarding_eyebrow_study" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:textColor="@color/onboarding_muted" />
                <TextView android:id="@+id/onboardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/onboarding_title_study" android:textSize="28sp" android:textStyle="bold" android:letterSpacing="-0.025" android:lineSpacingExtra="2dp" android:textColor="@color/text" />
                <TextView android:id="@+id/onboardDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:lineSpacingExtra="5dp" android:textColor="@color/onboarding_muted" android:text="@string/onboarding_caption_study" />
                <TextView android:id="@+id/dailyOnboardFeature" style="@style/DailyCaption" android:layout_marginTop="20dp" android:padding="12dp" android:background="@drawable/daily_mint_card" android:text="@string/daily_onboard_feature_welcome" />
                <LinearLayout android:id="@+id/onboardEducation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" android:visibility="gone">
                    <TextView style="@style/StudyLabel" android:text="@string/study_level_choose" android:labelFor="@id/onboardLevel" />
                    <Spinner android:id="@+id/onboardLevel" style="@style/StudyInput" android:entries="@array/study_level_picker" />
                    <TextView style="@style/DailyCaption" android:text="@string/study_level_note" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:paddingHorizontal="24dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/onboardBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_back" android:tint="@color/text" android:padding="14dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Langkah sebelumnya" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/onboardStep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="01 / 03" android:textSize="14sp" android:textColor="@color/onboarding_muted" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <Button android:id="@+id/onboardContinue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp" android:minHeight="52dp" android:paddingVertical="12dp" android:background="@drawable/bg_pine" android:stateListAnimator="@null" android:elevation="0dp" android:text="Lanjut" android:textAllCaps="false" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/white" />
    <TextView android:id="@+id/onboardGuestNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:text="@string/daily_onboard_guest" android:textSize="12sp" android:textColor="@color/onboarding_muted" />
</LinearLayout>
