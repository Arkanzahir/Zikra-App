<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pine"
    android:paddingHorizontal="24dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/onboardBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:tint="@color/white"
            android:padding="13dp"
            android:contentDescription="Kembali ke langkah sebelumnya" />
        <TextView
            android:id="@+id/onboardWordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="zikra."
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center" />
        <Button
            android:id="@+id/onboardSkip"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:text="Lewati"
            android:textAllCaps="false"
            android:textColor="#B5CEC4"
            android:textSize="13sp"
            android:padding="0dp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/onboardWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <com.zikra.app.discovery.LearningOrbitView
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:contentDescription="Orbit belajar: ilmu, ibadah, dan keseimbangan" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Bertumbuh dalam ilmu,\ndekat dalam iman."
                    android:textSize="30sp"
                    android:fontFamily="sans-serif-medium"
                    android:lineSpacingExtra="5dp"
                    android:textColor="@color/white" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:text="Teman perjalanan ibadah dan belajarmu.\nSatu langkah kecil, setiap hari."
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#B5CEC4" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/onboardIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="28dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kamu siapa?"
                    android:textColor="@color/pine"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kenalan dulu, agar perjalananmu\nterasa lebih personal."
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="28dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/onboardRoleStudent"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/onboard_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Pelajar atau mahasiswa">
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_graduation"
                            android:tint="@color/sage_active"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Pelajar"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/pine" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Belajar &amp; bertumbuh"
                            android:textSize="11sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/onboardRoleTeacher"
                        android:layout_width="0dp"
                        android:layout_height="168dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/onboard_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Pengajar">
                        <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_book"
                            android:tint="#CF9447"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="Pengajar"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/pine" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Berbagi pengetahuan"
                            android:textSize="11sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/onboardRoleParents"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/onboard_card"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="22dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Orang tua">
                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_heart"
                        android:tint="#C78E73"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orang tua"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/pine" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="Mendampingi langkah keluarga"
                            android:textSize="12sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/onboardTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:paddingTop="28dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apa yang kamu sukai?"
                    android:textColor="@color/pine"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pilih minatmu. Kamu dapat mengubahnya\nkapan saja melalui profil."
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp" />
                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_spark"
                    android:tint="#9A80C2"
                    android:importantForAccessibility="no"
                    android:layout_marginBottom="24dp" />
                <GridLayout
                    android:id="@+id/onboardInterests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Dibuat untuk ritme harimu."
                    android:textSize="12sp"
                    android:textColor="@color/muted"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
    <TextView
        android:id="@+id/onboardStep"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:text="●  ○  ○"
        android:textColor="#B5CEC4"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:importantForAccessibility="no" />
    <Button
        android:id="@+id/onboardContinue"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/onboard_primary"
        android:backgroundTint="@null"
        android:text="Mulai perjalanan"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>
