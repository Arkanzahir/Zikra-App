<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/calendar_card"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:clickable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <ImageView
        android:id="@+id/hadithIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:src="@drawable/ic_book"
        android:background="@drawable/circle_violet"
        android:tint="#9174AB"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="13dp">
        <TextView
            android:id="@+id/hadithItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/pine" />
        <TextView
            android:id="@+id/hadithItemSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textSize="14sp"
            android:textColor="#52665F"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/hadithItemSaved"
        android:layout_width="32dp"
        android:layout_height="36dp"
        android:text="›"
        android:textSize="24sp"
        android:gravity="center"
        android:textColor="#A0B4A8"
        android:importantForAccessibility="no" />
</LinearLayout>
