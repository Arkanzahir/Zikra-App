<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">
    <Button android:id="@+id/studyFaithJournal" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginBottom="12dp" android:text="@string/faith_title" android:textAllCaps="false" android:textColor="@color/pine" android:textSize="14sp" android:background="@drawable/concept_mint_card" android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="0dp"
        android:background="@null">
        <TextView
            android:id="@+id/study_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/layout_study_heading"
            android:textColor="@color/pine"
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="0dp" />
        <TextView
            android:id="@+id/study_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/concept_muted"
            android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/study_scope_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:text="@string/planner_study_scope"
            android:textColor="@color/concept_muted" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:fillViewport="true">
            <LinearLayout
                android:id="@+id/studyWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:baselineAligned="false" />
        </HorizontalScrollView>
    </LinearLayout>
    <TextView android:id="@+id/studyReminderLimit" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/weekly_task_alarm_limit" android:textSize="12sp" android:textColor="@color/muted" android:visibility="gone" />
    <Button android:id="@+id/studyEducation" style="@style/NearbyButton" android:text="@string/study_level_choose" android:visibility="gone" />
    <Button android:id="@+id/studyWeeklyClasses" style="@style/NearbyButton"
        android:layout_marginTop="8dp" android:layout_marginBottom="4dp"
        android:text="@string/weekly_title" android:visibility="gone" />
    <FrameLayout
        android:id="@+id/studyFocus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/study_scene_hero"
        android:clipToOutline="true"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">
        <com.zikra.app.ui.StudySceneView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:minHeight="132dp"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/concept_focus_card"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/studio_tint_dae9e0"
                android:id="@+id/studyFocusDuration"
                android:layout_marginTop="5dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/concept_focus_action"
                android:textSize="12sp"
                android:textColor="@color/pine"
                android:layout_marginTop="14dp"
                android:background="@drawable/concept_gold_button"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:textStyle="bold"
                android:minHeight="44dp"
                android:drawableStart="@drawable/audio_play"
                android:drawableTint="@color/pine"
                android:drawablePadding="5dp" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:id="@+id/study_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/studyTaskMetric"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/reference_paper_action"
            android:minHeight="72dp"
            android:layout_marginEnd="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_check"
                    android:background="@drawable/circle_mint"
                    android:padding="7dp"
                    android:tint="@color/pine"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:id="@+id/study_progress_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="16sp"
                        android:textColor="@color/pine"
                        android:layout_marginStart="0dp"
                        android:layout_marginTop="0dp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/studySummaryCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/study_scene_tasks_done"
                        android:textSize="10sp"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/concept_muted" />
                </LinearLayout>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/study_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="@color/pine"
                android:progressBackgroundTint="@color/studio_tint_e3e9e2" />
            <TextView
                android:id="@+id/study_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textColor="@color/pine"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/studyFocusMetric"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/reference_paper_action"
            android:minHeight="72dp"
            android:layout_marginStart="5dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/protector_ic_clock"
                    android:background="@drawable/studio_icon_gold"
                    android:padding="7dp"
                    android:tint="@color/concept_gold_ink"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="16sp"
                        android:textColor="@color/pine"
                        android:id="@+id/studySessionCaption"
                        android:layout_marginTop="0dp"
                        android:layout_marginStart="0dp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/studyElapsedCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/study_scene_focus_elapsed"
                        android:textSize="10sp"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/concept_muted" />
                </LinearLayout>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/studyElapsedProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressTint="@color/concept_gold"
                android:progressBackgroundTint="@color/concept_line" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/agenda_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/study_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agenda_remaining"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/pine" />
        <TextView
            android:id="@+id/hifz_planned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textColor="@color/study_secondary" />
        <TextView
            android:id="@+id/studyAddInline"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/study_scene_add"
            android:textSize="12sp"
            android:textColor="@color/pine"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/concept_mint_card" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/study_filters"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/study_tabs_bg"
        android:padding="3dp">
        <TextView android:id="@+id/study_filter_all" style="@style/study_Filter" android:text="@string/study_all" />
        <TextView android:id="@+id/study_filter_study" style="@style/study_Filter" android:text="@string/study_category_study" />
        <TextView android:id="@+id/study_filter_ibadah" style="@style/study_Filter" android:text="@string/study_category_ibadah" />
        <TextView android:id="@+id/study_filter_hifz" style="@style/study_Filter" android:text="@string/study_category_hifz" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/agenda_feature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="@drawable/concept_paper_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <View android:layout_width="20dp" android:layout_height="2dp" android:background="@color/camel" android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/agenda_feature_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textColor="@color/concept_gold_ink"
                android:text="@string/agenda_continue" />
            <ImageButton
                android:id="@+id/agenda_feature_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-10dp"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="-6dp"
                android:padding="14dp"
                android:src="@drawable/study_ic_more"
                android:tint="@color/studio_tint_d5e2d8"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/study_task_actions" />
        </LinearLayout>
        <TextView
            android:id="@+id/agenda_feature_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="@color/pine" />
        <TextView
            android:id="@+id/agenda_feature_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/pine" />
        <TextView
            android:id="@+id/agenda_feature_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="@color/concept_muted" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/agenda_feature_check"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:buttonTint="@color/studio_tint_e6ba77"
                android:text="@string/agenda_complete"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:paddingEnd="12dp" />
            <Button
                android:id="@+id/agenda_feature_action"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/concept_mint_card"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/pine"
                android:text="@string/agenda_edit" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/study_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingVertical="16dp"
        android:text="@string/study_empty"
        android:textColor="@color/pine"
        android:textSize="13sp"
        android:visibility="gone"
        android:background="@drawable/reference_gold_card"
        android:padding="16dp"
        android:lineSpacingExtra="3dp" />
    <Button
        android:id="@+id/ibadah_template"
        style="@style/StudyButton"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:background="@drawable/study_tabs_bg"
        android:textColor="@color/pine"
        android:text="@string/planner_prayer_template"
        android:visibility="gone" />
</LinearLayout>
