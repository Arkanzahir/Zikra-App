<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">
    <TextView
        android:id="@+id/study_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/study_secondary" />
    <TextView
        android:id="@+id/study_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/agenda_heading"
        android:textColor="@color/pine"
        android:textSize="26sp"
        android:textStyle="bold"
        android:lineSpacingExtra="0dp" />
    <TextView
        android:id="@+id/study_scope_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:text="@string/planner_study_scope"
        android:textColor="@color/study_secondary" />
    <Button android:id="@+id/studyFocus" style="@style/NearbyButton" android:layout_marginTop="14dp" android:text="Fokus belajar" android:visibility="gone" />
    <LinearLayout
        android:id="@+id/study_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/study_progress_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@color/study_secondary" />
            <TextView
                android:id="@+id/study_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textColor="@color/pine"
                android:textStyle="bold" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/study_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="@color/pine"
            android:progressBackgroundTint="#E3E9E2" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/study_filters"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/study_tabs_bg"
        android:padding="3dp">
        <TextView
            android:id="@+id/study_filter_all"
            style="@style/study_Filter"
            android:text="@string/study_all" />
        <TextView
            android:id="@+id/study_filter_study"
            style="@style/study_Filter"
            android:text="@string/study_category_study" />
        <TextView
            android:id="@+id/study_filter_ibadah"
            style="@style/study_Filter"
            android:text="@string/study_category_ibadah" />
        <TextView
            android:id="@+id/study_filter_hifz"
            style="@style/study_Filter"
            android:text="@string/study_category_hifz" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/agenda_feature"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="18dp"
        android:orientation="vertical"
        android:background="@drawable/agenda_feature">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <View
                android:layout_width="20dp"
                android:layout_height="2dp"
                android:background="@color/camel"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/agenda_feature_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textColor="#E6BA77"
                android:text="@string/agenda_continue" />
            <ImageButton
                android:id="@+id/agenda_feature_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-10dp"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="-6dp"
                android:padding="14dp"
                android:src="@drawable/study_ic_more"
                android:tint="#D5E2D8"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/study_task_actions" />
        </LinearLayout>
        <TextView
            android:id="@+id/agenda_feature_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="13sp"
            android:textColor="#BED2C7" />
        <TextView
            android:id="@+id/agenda_feature_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white" />
        <TextView
            android:id="@+id/agenda_feature_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textColor="#D5E2D8" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">
            <CheckBox
                android:id="@+id/agenda_feature_check"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:buttonTint="#E6BA77"
                android:text="@string/agenda_complete"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:paddingEnd="12dp" />
            <Button
                android:id="@+id/agenda_feature_action"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:minWidth="48dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/agenda_feature_action"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/pine"
                android:text="@string/agenda_edit" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/study_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="20dp"
        android:text="@string/study_empty"
        android:textColor="@color/study_secondary"
        android:textSize="14sp"
        android:visibility="gone" />
    <Button
        android:id="@+id/ibadah_template"
        style="@style/StudyButton"
        android:layout_width="match_parent"
        android:layout_marginBottom="12dp"
        android:background="@drawable/study_tabs_bg"
        android:textColor="@color/pine"
        android:text="@string/planner_prayer_template"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/agenda_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/study_section"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agenda_remaining"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/pine" />
        <TextView
            android:id="@+id/hifz_planned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textColor="@color/study_secondary" />
    </LinearLayout>
</LinearLayout>
