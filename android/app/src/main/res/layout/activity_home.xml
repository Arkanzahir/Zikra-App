<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="116dp"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="340dp"
                android:background="@drawable/bg_home_hero">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="20dp"
                    android:src="@drawable/mosque_silhouette"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:paddingTop="8dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/brandmark_white"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:text="zikra."
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:letterSpacing="-0.06"
                            android:textColor="@color/white" />
                        <TextView
                            android:id="@+id/homeProfile"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:background="@drawable/circle_glass"
                            android:text="A"
                            android:textColor="#D9EAE4"
                            android:textSize="18sp"
                            android:contentDescription="Buka profil"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:gravity="center_vertical"
                        android:layout_marginTop="1dp">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_pin"
                            android:tint="#BDD4CB"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Sukolilo, Surabaya"
                            android:textColor="#BDD4CB"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Assalamualaikum, Arkan"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/white" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Ibadah terjaga. Tugas tertata."
                                android:textColor="#9DBDB1"
                                android:textSize="10sp" />
                        </LinearLayout>
                        <ImageButton
                            android:id="@+id/homeEmergency"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="11dp"
                            android:background="@drawable/circle_glass"
                            android:src="@drawable/ic_bell"
                            android:tint="#D9EAE4"
                            android:contentDescription="Bantuan cepat dan darurat" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/homeHijri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="15 Jumada Al-Akhira, 1447 AH"
                        android:textSize="11sp"
                        android:textColor="#B8D3C8" />
                    <TextView
                        android:id="@+id/homeClock"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:gravity="center"
                        android:text="14:54"
                        android:textColor="@color/white"
                        android:textSize="70sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.06"
                        android:includeFontPadding="false"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/homeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:paddingHorizontal="15dp"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown"
                        android:text="Maghrib tinggal 27 menit lagi"
                        android:textColor="#E3F0E9"
                        android:textSize="11sp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="#1FFFFFFF" />
                    <LinearLayout
                        android:id="@+id/homePrayerStrip"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:id="@+id/prayerSlot0"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="57dp"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_moon"
                                android:tint="#C0D8CF"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Subuh"
                                android:textColor="#C0D8CF"
                                android:textSize="8sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="04:12"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot1"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="57dp"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_sun"
                                android:tint="#C0D8CF"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Terbit"
                                android:textColor="#C0D8CF"
                                android:textSize="8sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="05:28"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot2"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="57dp"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_sun"
                                android:tint="#C0D8CF"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Dzuhur"
                                android:textColor="#C0D8CF"
                                android:textSize="8sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="11:35"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot3"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="57dp"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_sun"
                                android:tint="#C0D8CF"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Ashar"
                                android:textColor="#C0D8CF"
                                android:textSize="8sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="14:52"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot4"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="57dp"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_sun"
                                android:tint="#C0D8CF"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Maghrib"
                                android:textColor="#C0D8CF"
                                android:textSize="8sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="17:41"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot5"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="57dp"
                            android:layout_marginHorizontal="2dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="17dp"
                                android:src="@drawable/ic_moon"
                                android:tint="#C0D8CF"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Isya"
                                android:textColor="#C0D8CF"
                                android:textSize="8sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="18:50"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-20dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_card"
                android:elevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/shortcutQuran"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Al-Qur'an">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_book"
                            android:tint="#B38335" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Al-Qur'an"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutDua"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Doa Harian">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_heart"
                            android:tint="#B38335" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Doa Harian"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutQibla"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Kiblat">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_compass"
                            android:tint="#B38335" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Kiblat"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutPrayer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Jadwal Sholat">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_sun"
                            android:tint="#B38335" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Jadwal Sholat"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/shortcutAi"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Zikra AI">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_spark"
                            android:tint="#9466CF" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Zikra AI"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutProtector"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Protector BMKG">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_shield"
                            android:tint="#159777" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Protector BMKG"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutStudy"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Study Hub">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_tasks"
                            android:tint="#548EAD" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Study Hub"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutInfaq"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Infaq Kampus">
                        <ImageView
                            style="@style/ShortcutIcon"
                            android:src="@drawable/ic_heart"
                            android:tint="#D47865" />
                        <TextView
                            style="@style/ShortcutLabel"
                            android:text="Infaq Kampus"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Target Ibadah &amp; Belajar Hari Ini"
                        android:textColor="@color/text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeProgressPercent"
                        android:layout_width="42dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pine"
                        android:text="33%"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/homeProgressSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Selesaikan 8 dari 24 checklist harian"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
                <com.zikra.app.ui.SegmentedProgressView
                    android:id="@+id/homeProgressTicks"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="20dp"
                    android:importantForAccessibility="yes" />
                <Button
                    android:id="@+id/homeChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_amber"
                    android:backgroundTint="@color/amber"
                    android:text="Buka Checklist Ibadah"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:stateListAnimator="@null" />
            </LinearLayout>
            <TextView
                android:id="@+id/homeLastRead"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:drawableStart="@drawable/ic_book"
                android:drawablePadding="12dp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="18dp"
                android:text="zikra.  •  Small steps. Meaningful days."
                android:textSize="10sp"
                android:textColor="@color/muted" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_dock"
        android:elevation="14dp"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/dockHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                android:tint="@color/emerald"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Home"
                android:textColor="@color/emerald"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dockQuran"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quran"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book"
                android:tint="#8A9BA9"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Quran"
                android:textColor="#8A9BA9"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="1dp" />
        <LinearLayout
            android:id="@+id/dockStudy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Study"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tasks"
                android:tint="#8A9BA9"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Study"
                android:textColor="#8A9BA9"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dockProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Profile"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_user"
                android:tint="#8A9BA9"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Profile"
                android:textColor="#8A9BA9"
                android:importantForAccessibility="no" />
