            <TextView android:id="@+id/homeProgressPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="0dp" android:paddingHorizontal="0dp" android:paddingVertical="0dp" android:layout_marginStart="8dp" android:gravity="center" android:background="@null" android:text="0%" android:textColor="@color/pine" android:textSize="10sp" android:textStyle="bold" />
          </LinearLayout>
          <TextView android:id="@+id/homeProgressSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Belum ada ibadah yang dicatat." android:textColor="@color/muted" android:textSize="13sp" />
          <com.zikra.app.ui.SegmentedProgressView android:id="@+id/homeProgressTicks" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="7dp" android:importantForAccessibility="yes" />
        </LinearLayout>
        <Button android:id="@+id/homeChecklist" android:layout_width="100dp" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="6dp" android:paddingVertical="6dp" android:layout_marginTop="0dp" android:background="@drawable/concept_gold_button" android:backgroundTint="@null" android:text="Buka checklist ibadah" android:textAllCaps="false" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/pine" android:stateListAnimator="@null" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refresh_home_agenda" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/pine" android:accessibilityHeading="true" />
        <TextView android:id="@+id/homeAgendaCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="@color/muted" />
        <LinearLayout android:id="@+id/homeAgendaItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/refresh_outline" />
        <TextView android:id="@+id/homeAgendaAll" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/refresh_home_agenda_all" android:textSize="14sp" android:textColor="@color/studio_teal" android:textStyle="bold" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground" />
      </LinearLayout>
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:layout_marginHorizontal="20dp" android:layout_marginTop="12dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/weekly_today" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/pine" android:accessibilityHeading="true" />
        <LinearLayout android:id="@+id/homeClasses" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:orientation="vertical" android:background="@drawable/refresh_outline" />
        <TextView android:id="@+id/homeClassesOpen" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/weekly_open"
            android:textSize="14sp" android:textColor="@color/studio_teal" android:clickable="true" android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />
      </LinearLayout>
      <LinearLayout android:id="@+id/homeFocusCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="20dp" android:background="@drawable/studio_hero" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refresh_home_focus" android:textSize="21sp" android:textColor="@color/white" android:textStyle="bold" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refresh_home_focus_caption" android:textSize="14sp" android:textColor="@color/studio_tint_d8ebdd" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refresh_home_focus_action" android:textSize="14sp" android:textColor="@color/studio_tint_f4d69d" android:layout_marginTop="16dp" android:textStyle="bold" />
        </LinearLayout>
        <ImageView android:layout_width="56dp" android:layout_height="80dp" android:src="@drawable/studio_books" android:importantForAccessibility="no" android:scaleType="fitCenter" />
      </LinearLayout>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:paddingVertical="16dp" android:text="@string/refresh_home_end" android:textSize="13sp" android:textColor="@color/muted" android:gravity="center" />
    </LinearLayout>
  </ScrollView>
</FrameLayout>
