<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/homeHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/home_hero_height"
                android:background="@drawable/bg_home_hero">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="144dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="22dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/mosque_silhouette"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/home_hero_bottom_padding"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="@dimen/home_hero_top_padding">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:id="@+id/homeLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:paddingEnd="14dp"
                            android:gravity="center_vertical"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Buka lokasi Sukolilo, Surabaya di peta">
                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:padding="8dp"
                                android:background="@drawable/circle_glass"
                                android:src="@drawable/ic_pin"
                                android:tint="@color/home_hero_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Sukolilo, Surabaya"
                                android:textSize="10sp"
                                android:textColor="@color/home_hero_text" />
                        </LinearLayout>
                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <ImageButton
                            android:id="@+id/homeSearch"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="15dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/reading_ic_search"
                            android:tint="@color/home_hero_text"
                            android:contentDescription="Cari surah Al-Qur’an" />
                        <ImageButton
                            android:id="@+id/homeReminders"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="15dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_bell"
                            android:tint="@color/home_hero_text"
                            android:contentDescription="Jadwal dan pengaturan pengingat sholat" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/homeHijri"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_date_height"
                        android:layout_marginTop="@dimen/home_date_margin"
                        android:gravity="center"
                        android:text="Jumadil Awal 1448 H"
                        android:textSize="11sp"
                        android:textColor="@color/home_hero_text"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/homeClock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="82dp"
                        android:gravity="center"
                        android:text="14:54"
                        android:textColor="@color/white"
                        android:textSize="70sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.06"
                        android:includeFontPadding="false"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/homeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/home_countdown_margin"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown"
                        android:text="Maghrib tinggal 27 menit lagi"
                        android:textColor="@color/home_hero_text"
                        android:textSize="10sp" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/home_strip_divider_margin"
                        android:background="#20FFFFFF" />
                    <LinearLayout
                        android:id="@+id/homePrayerStrip"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/home_strip_height"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Buka jadwal sholat lengkap">
                        <LinearLayout
                            android:id="@+id/prayerSlot0"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/home_prayer_slot_height"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="1dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_moon"
                                android:tint="@color/home_prayer_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Subuh"
                                android:textColor="@color/home_prayer_text"
                                android:textSize="8sp"
                                android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="04:12"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot1"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/home_prayer_slot_height"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="1dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_sun"
                                android:tint="@color/home_prayer_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Terbit"
                                android:textColor="@color/home_prayer_text"
                                android:textSize="8sp"
                                android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="05:28"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot2"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/home_prayer_slot_height"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="1dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_sun"
                                android:tint="@color/home_prayer_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Dzuhur"
                                android:textColor="@color/home_prayer_text"
                                android:textSize="8sp"
                                android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="11:35"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot3"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/home_prayer_slot_height"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="1dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_sun"
                                android:tint="@color/home_prayer_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Ashar"
                                android:textColor="@color/home_prayer_text"
                                android:textSize="8sp"
                                android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="14:52"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot4"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/home_prayer_slot_height"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="1dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_sun"
                                android:tint="@color/home_prayer_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Maghrib"
                                android:textColor="@color/home_prayer_text"
                                android:textSize="8sp"
                                android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="17:41"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/prayerSlot5"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/home_prayer_slot_height"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="1dp"
                            android:gravity="center"
                            android:orientation="vertical">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_moon"
                                android:tint="@color/home_prayer_text"
                                android:importantForAccessibility="no" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Isya"
                                android:textColor="@color/home_prayer_text"
                                android:textSize="8sp"
                                android:includeFontPadding="false" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="18:50"
                                android:textColor="@color/white"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout
                android:id="@+id/homeShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="-22dp"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="@dimen/home_shortcuts_padding"
                android:background="@drawable/bg_card"
                android:elevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_shortcut_row_height"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/shortcutQuran"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Al-Qur’an">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_book"
                            android:tint="@color/home_gold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Al-Qur’an"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutDua"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Doa Harian">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/home_gold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Doa Harian"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutQibla"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Kiblat">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_compass"
                            android:tint="@color/home_gold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Kiblat"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutPrayer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Jadwal Sholat">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_sun"
                            android:tint="@color/home_gold"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Jadwal Sholat"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_shortcut_row_height"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/shortcutAi"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Zikra AI">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_spark"
                            android:tint="@color/home_violet"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Zikra AI"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutProtector"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Protector BMKG">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_shield"
                            android:tint="@color/home_emerald"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Protector BMKG"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutStudy"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Study Hub">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_tasks"
                            android:tint="@color/home_blue"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Study Hub"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutHadith"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Hadis">
                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/home_ic_hadith"
                            android:tint="@color/home_coral"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Hadis"
                            android:textSize="9sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/homeTargetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="@dimen/home_target_spacing"
                android:orientation="vertical"
                android:padding="@dimen/home_target_padding"
                android:background="@drawable/bg_card"
                android:elevation="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Target Ibadah &amp; Belajar Hari Ini"
                        android:textColor="@color/pine"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeProgressPercent"
                        android:layout_width="40dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pine"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/homeProgressSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Selesaikan checklist harianmu"
                    android:textColor="@color/muted"
                    android:textSize="10sp" />
                <com.zikra.app.ui.SegmentedProgressView
                    android:id="@+id/homeProgressTicks"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_tick_height"
                    android:layout_marginTop="@dimen/home_target_spacing"
                    android:importantForAccessibility="yes" />
                <Button
                    android:id="@+id/homeChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/home_target_spacing"
                    android:background="@drawable/home_cta"
                    android:backgroundTint="@null"
                    android:text="Buka Checklist Ibadah"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:stateListAnimator="@null" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/homeContinueReading"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:background="@drawable/home_shortcut_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="9dp"
                    android:background="@drawable/circle_mint"
                    android:src="@drawable/ic_book"
                    android:tint="@color/pine"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lanjutkan bacaan"
                        android:textColor="@color/pine"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeLastRead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/home_ic_chevron"
                    android:tint="@color/muted"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_dock"
        android:elevation="14dp"
        android:paddingHorizontal="10dp"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/dockHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                android:tint="@color/emerald"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Home"
                android:textColor="@color/emerald"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dockQuran"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Quran"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_book"
                android:tint="#8A9BA9"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Quran"
                android:textColor="#8A9BA9"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <Space
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="1dp" />
        <LinearLayout
            android:id="@+id/dockStudy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Study"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_tasks"
                android:tint="#8A9BA9"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Study"
                android:textColor="#8A9BA9"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dockProfile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Profil"
            android:background="?android:attr/selectableItemBackgroundBorderless">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_user"
                android:tint="#8A9BA9"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/DockLabel"
                android:text="Profil"
                android:textColor="#8A9BA9"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/dockAi"
        android:layout_width="68dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="18dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Zikra AI">
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="15dp"
            android:background="@drawable/bg_ai"
            android:src="@drawable/ic_spark"
            android:tint="@color/white"
            android:elevation="8dp"
            android:importantForAccessibility="no" />
        <TextView
            style="@style/DockLabel"
            android:layout_marginTop="7dp"
            android:text="Zikra AI"
            android:textColor="#9376BC"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
