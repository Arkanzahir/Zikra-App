            </com.zikra.app.ui.CurvedShortcutLayout>
            <LinearLayout
                android:id="@+id/homeTargetCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="@dimen/home_target_spacing"
                android:orientation="vertical"
                android:padding="@dimen/home_target_padding"
                android:background="@drawable/bg_card"
                android:elevation="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ibadah hari ini"
                        android:textColor="@color/pine"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp" android:minHeight="32dp"
                        android:paddingHorizontal="10dp" android:paddingVertical="5dp"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:background="@drawable/bg_pine"
                        android:text="0%"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/homeProgressSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Belum ada ibadah yang dicatat."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
                <com.zikra.app.ui.SegmentedProgressView
                    android:id="@+id/homeProgressTicks"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/home_tick_height"
                    android:layout_marginTop="@dimen/home_target_spacing"
                    android:importantForAccessibility="yes" />
                <Button
                    android:id="@+id/homeChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginTop="@dimen/home_target_spacing"
                    android:background="@drawable/home_cta"
                    android:backgroundTint="@null"
                    android:text="Buka checklist ibadah"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/pine"
                    android:stateListAnimator="@null" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/homeContinueReading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:paddingVertical="12dp"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:gravity="center_vertical"
                android:background="@drawable/home_shortcut_ripple"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="9dp"
                    android:background="@drawable/circle_mint"
                    android:src="@drawable/ic_book"
                    android:tint="@color/pine"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lanjutkan bacaan"
                        android:textColor="@color/pine"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/homeLastRead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/home_ic_chevron"
                    android:tint="@color/muted"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
