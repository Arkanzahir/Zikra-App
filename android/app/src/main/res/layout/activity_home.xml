                                    android:text="11:35"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/prayerSlot3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="64dp"
                                android:paddingVertical="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="1dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ashar"
                                    android:textColor="@color/home_prayer_text"
                                    android:textSize="10sp"
                                    android:includeFontPadding="false" />
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginTop="6dp"
                                    android:src="@drawable/home_prayer_afternoon"
                                    android:tint="@color/home_prayer_text"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="14:52"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/prayerSlot4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="64dp"
                                android:paddingVertical="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="1dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Maghrib"
                                    android:textColor="@color/home_prayer_text"
                                    android:textSize="10sp"
                                    android:includeFontPadding="false" />
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginTop="6dp"
                                    android:src="@drawable/home_prayer_sunset"
                                    android:tint="@color/home_prayer_text"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="17:41"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                            <LinearLayout
                                android:id="@+id/prayerSlot5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:minHeight="64dp"
                                android:paddingVertical="8dp"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="1dp"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Isya"
                                    android:textColor="@color/home_prayer_text"
                                    android:textSize="10sp"
                                    android:includeFontPadding="false" />
                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginTop="6dp"
                                    android:src="@drawable/home_prayer_moon"
                                    android:tint="@color/home_prayer_text"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:text="18:50"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:includeFontPadding="false" />
                            </LinearLayout>
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </FrameLayout>
            <com.zikra.app.ui.CurvedShortcutLayout
                android:id="@+id/homeShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginTop="-22dp"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="@dimen/home_shortcuts_padding"
                android:elevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:id="@+id/shortcutQuran"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingVertical="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Al-Qur’an">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:padding="10dp"
                            android:src="@drawable/home_ic_quran"
                            android:tint="@color/pine"
                            android:importantForAccessibility="no"
                            android:background="@drawable/studio_icon_mint" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Al-Qur’an"
                            android:textSize="13sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutDua"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingVertical="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Doa Harian">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:padding="10dp"
                            android:src="@drawable/home_ic_dua"
                            android:tint="@color/pine"
                            android:importantForAccessibility="no"
                            android:background="@drawable/studio_icon_gold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Doa Harian"
                            android:textSize="13sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutQibla"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingVertical="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Kiblat">
                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:padding="10dp"
                            android:src="@drawable/home_ic_qibla"
                            android:tint="@color/pine"
                            android:importantForAccessibility="no"
                            android:background="@drawable/studio_icon_blue" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="24dp"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Kiblat"
                            android:textSize="13sp"
                            android:textColor="@color/pine"
                            android:maxLines="2"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/shortcutHifz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:paddingVertical="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/home_shortcut_ripple"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Diary Hifz">
