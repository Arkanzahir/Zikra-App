<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">
            <FrameLayout
                android:id="@+id/homeHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/home_hero_height"
                android:background="@drawable/bg_home_hero">
                <com.zikra.app.sky.HomeSkyView
                    android:id="@+id/homeSky"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/home_hero_bottom_padding"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="@dimen/home_hero_top_padding">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="64dp"
                        android:gravity="center_vertical">
                        <LinearLayout android:id="@+id/homeLocation" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:minHeight="64dp" android:orientation="vertical" android:gravity="center_vertical"
                            android:theme="@style/ZikraBrandDark" android:clickable="true" android:focusable="true"
                            android:background="?android:attr/selectableItemBackground" android:contentDescription="Lokasi Sukolilo, Surabaya. Buka peta">
                            <include layout="@layout/view_zikra_brand" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="11dp" android:text="Sukolilo, Surabaya" android:textSize="12sp" android:textColor="#D2DFD8" />
                        </LinearLayout>
                        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                        <ImageButton
                            android:id="@+id/homeSearch"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="15dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/reading_ic_search"
                            android:tint="@color/home_hero_text"
                            android:contentDescription="Cari surah Al-Qur’an" />
                        <ImageButton
                            android:id="@+id/homeReminders"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:padding="15dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_bell"
                            android:tint="@color/home_hero_text"
                            android:contentDescription="Jadwal dan pengaturan pengingat sholat" />
                    </LinearLayout>
                    <TextView android:id="@+id/homeSkySource" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:minHeight="48dp"
                        android:gravity="center" android:text="Langit · perkiraan lokal" android:textSize="12sp"
                        android:textColor="#AAC1B6" android:clickable="true" android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless" />
                    <TextView
                        android:id="@+id/homeHijri"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="@dimen/home_date_margin"
                        android:gravity="center"
                        android:text="Jumadil Awal 1448 H"
                        android:textSize="13sp"
                        android:textColor="@color/home_hero_text"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true" />
                    <TextView
                        android:id="@+id/homeClock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="82dp"
                        android:gravity="center"
                        android:text="14:54"
                        android:textColor="@color/white"
                        android:textSize="70sp"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="32sp"
                        android:autoSizeMaxTextSize="70sp"
                        android:autoSizeStepGranularity="1sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.06"
                        android:includeFontPadding="false"
                        android:fontFeatureSettings="tnum" />
                    <TextView
                        android:id="@+id/homeCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:minHeight="32dp"
                        android:paddingVertical="5dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/home_countdown_margin"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:background="@drawable/bg_countdown"
                        android:text="Maghrib tinggal 27 menit lagi"
                        android:textColor="@color/home_hero_text"
                        android:textSize="12sp" />
