<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="12dp" android:paddingBottom="12dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quran_arabic_size" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp"
            android:labelFor="@id/quranArabicSize" />
        <TextView android:id="@+id/quranArabicSizeValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/app_ink_50665b" android:textSize="13sp" android:importantForAccessibility="no" />
        <SeekBar android:id="@+id/quranArabicSize" android:layout_width="match_parent" android:layout_height="48dp"
            android:max="20" android:progressTint="@color/pine" android:thumbTint="@color/pine" />
        <TextView android:id="@+id/quranArabicPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/amiri_quran" android:includeFontPadding="true"
            android:text="ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ" android:textDirection="rtl" android:gravity="end"
            android:textColor="@color/text" android:paddingBottom="16dp" android:lineSpacingExtra="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quran_translation_size" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp"
            android:labelFor="@id/quranTranslationSize" />
        <TextView android:id="@+id/quranTranslationSizeValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/app_ink_50665b" android:textSize="13sp" android:importantForAccessibility="no" />
        <SeekBar android:id="@+id/quranTranslationSize" android:layout_width="match_parent" android:layout_height="48dp"
            android:max="10" android:progressTint="@color/pine" android:thumbTint="@color/pine" />
        <TextView android:id="@+id/quranTranslationPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quran_settings_preview" android:textColor="@color/app_ink_50665b" android:lineSpacingExtra="4dp" android:paddingBottom="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/quran_appearance" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp" />
        <RadioGroup android:id="@+id/quranThemeChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <RadioButton android:id="@+id/quranThemeLight" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/quran_light" android:textSize="14sp" android:textColor="@color/text" android:buttonTint="@color/app_accent" />
            <RadioButton android:id="@+id/quranThemeDark" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/quran_dark" android:textSize="14sp" android:textColor="@color/text" android:buttonTint="@color/app_accent" />
            <RadioButton android:id="@+id/quranThemeAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/quran_auto" android:textSize="14sp" android:textColor="@color/text" android:buttonTint="@color/app_accent" />
        </RadioGroup>
        <Button android:id="@+id/quranSettingsJump" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="12dp" android:text="@string/quran_jump" android:textAllCaps="false" android:textSize="14sp" android:textColor="@color/text" />
        <Button android:id="@+id/quranOpenMushaf" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/mushaf_open" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
