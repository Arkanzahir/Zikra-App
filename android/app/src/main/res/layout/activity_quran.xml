<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quranPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/quranRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/concept_ivory">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:minHeight="56dp"
            android:id="@+id/quranToolbar">
            <ImageButton
                android:id="@+id/toolbarBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back"
                android:tint="@color/pine"
                android:padding="13dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Kembali" />
            <TextView
                android:id="@+id/quranTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Al-Quran"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/pine" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:id="@+id/quranReaderToolbar"
                android:visibility="gone">
                <Spinner
                    android:id="@+id/surahSelector"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:layout_height="36dp"
                    android:spinnerMode="dropdown"
                    android:visibility="gone"
                    android:contentDescription="Pilih surah" />
                <TextView
                    android:id="@+id/surahMetadata"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/concept_muted"
                    android:gravity="center" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/quranHeaderSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/reading_ic_search"
                android:tint="@color/pine"
                android:padding="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cari surah" />
            <ImageButton
                android:id="@+id/quranCatalogButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_book"
                android:tint="@color/pine"
                android:padding="14dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Daftar surah" />
            <ImageButton
                android:id="@+id/quranReadingOptions"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/study_scene_settings_icon"
                android:tint="@color/pine"
                android:padding="14dp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Pengaturan bacaan" />
        </LinearLayout>
        <View
            android:id="@+id/quranHeaderDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/studio_tint_e9ede8"
            android:visibility="gone" />
        <ScrollView
            android:id="@+id/quranScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="88dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/quranCatalog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/reference_quran_hero">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/concept_quran_eyebrow"
                                    android:textSize="11sp"
                                    android:textColor="@color/studio_tint_d4e9dc"
                                    android:letterSpacing="0"
                                    android:textStyle="normal" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/concept_quran_heading"
                                    android:textSize="24sp"
                                    android:textColor="@color/white"
                                    android:layout_marginTop="3dp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reference_quran_caption"
                                    android:textSize="11sp"
                                    android:textColor="@color/studio_tint_dae9e0"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="98dp"
                                android:layout_height="104dp"
                                android:src="@drawable/reference_quran_book"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/quranIntro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Baca dengan tenang, lanjutkan dari ayat terakhirmu."
                        android:visibility="gone"
                        android:textSize="12sp" />
                    <LinearLayout
                        android:id="@+id/quranSearchCard"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/reading_search"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/reading_ic_search"
                            android:importantForAccessibility="no" />
                        <EditText
                            android:id="@+id/quranSearch"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:background="@null"
                            android:singleLine="true"
                            android:inputType="text"
                            android:imeOptions="actionSearch"
                            android:textSize="14sp"
                            android:textColor="@color/pine"
                            android:textColorHint="@color/studio_tint_7e8f86"
                            android:hint="Nama atau nomor surah"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/quranResume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:background="@drawable/concept_mint_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">
                        <ImageView
                            android:id="@+id/quranResumeIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_book"
                            android:tint="@color/pine"
                            android:importantForAccessibility="no" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">
                            <TextView
                                android:id="@+id/quranResumeHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/reference_last_read"
                                android:textSize="10sp"
                                android:textColor="@color/studio_tint_5d7365" />
                            <TextView
                                android:id="@+id/lastReadLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/pine" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_back"
                            android:rotation="180"
                            android:tint="@color/pine"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:baselineAligned="false">
                        <Button
                            android:id="@+id/quranCatalogMushaf"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginTop="0dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:background="@drawable/reference_paper_action"
                            android:backgroundTint="@null"
                            android:text="@string/reference_open_mushaf"
                            android:textColor="@color/pine"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:textStyle="bold"
                            android:stateListAnimator="@null"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/home_ic_quran"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/pine" />
                        <Button
                            android:id="@+id/quranCatalogDownloads"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:background="@drawable/reference_paper_action"
                            android:backgroundTint="@null"
                            android:text="@string/concept_quran_downloads"
                            android:textColor="@color/pine"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:stateListAnimator="@null"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:drawableStart="@drawable/audio_download"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/pine" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/quranSurahHeading"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="@string/concept_quran_surah"
                            android:textColor="@color/pine"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_weight="1" />
                        <TextView
                            android:id="@+id/quranBrowseJuz"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/reference_juz"
                            android:textSize="12sp"
                            android:textColor="@color/concept_muted"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground"
                            android:contentDescription="@string/reference_juz_action" />
                        <TextView
                            android:id="@+id/quranBookmark"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/reference_bookmarks"
                            android:textSize="12sp"
                            android:textColor="@color/concept_muted"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?android:attr/selectableItemBackground"
                            android:contentDescription="@string/reference_bookmark_action" />
                    </LinearLayout>
                    <View android:layout_width="96dp" android:layout_height="2dp" android:background="@color/pine" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/studio_tint_e9ede8" />
                    <TextView
                        android:id="@+id/readingAvailable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="114 surah"
                        android:textSize="10sp"
                        android:textColor="@color/studio_tint_52685d"
                        android:paddingTop="7dp"
                        android:paddingBottom="5dp" />
                    <LinearLayout
                        android:id="@+id/quranSurahList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView
                        android:id="@+id/quranEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="24dp"
                        android:text="Surah tidak ditemukan. Coba nama lainnya."
                        android:textSize="14sp"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/quranFootnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="16dp"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp"
                        android:text="Sumber bacaan: Quran.com / Quran Foundation. Empat surah tersedia bawaan; bagian yang baru dibuka disimpan terbatas di perangkat." />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/quranReader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/quranSurahHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:background="@drawable/reader_heading_frame"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:id="@+id/surahArabicTitle"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="0dp"
                            android:gravity="center"
                            android:textDirection="rtl"
                            android:textSize="40sp"
                            android:textColor="@color/pine"
                            android:paddingVertical="8dp"
                            android:includeFontPadding="false" />
                        <ImageView
                            android:id="@+id/readerTitleFlourish"
                            android:layout_width="80dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center_horizontal"
                            android:src="@drawable/reader_heading_flourish"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:id="@+id/surahBismillah"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textDirection="rtl"
                            android:textSize="25sp"
                            android:textColor="@color/pine"
                            android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/quranVisibleTools"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="0dp"
                        android:layout_marginTop="0dp"
                        android:background="@null"
                        android:layout_marginBottom="8dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical">
                        <Button
                            android:id="@+id/quranReaderMushaf"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingHorizontal="6dp"
                            android:text="@string/layout_mushaf"
                            android:textColor="@color/pine"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:background="@drawable/reference_paper_action"
                            android:stateListAnimator="@null"
                            android:layout_weight="1"
                            android:maxLines="4" />
                        <Button
                            android:id="@+id/quranReaderFont"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="48dp"
                            android:text="@string/layout_font"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:textColor="@color/pine"
                            android:background="@drawable/reference_paper_action"
                            android:layout_marginStart="6dp"
                            android:maxLines="4" />
                        <Button
                            android:id="@+id/quranReaderAudio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingHorizontal="6dp"
                            android:text="@string/layout_audio"
                            android:textColor="@color/pine"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            android:background="@drawable/reference_paper_action"
                            android:stateListAnimator="@null"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:maxLines="4" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/quranThemePanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <Switch
                            android:id="@+id/readingNightSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Mode baca malam"
                            android:textSize="12sp"
                            android:showText="false" />
                        <TextView
                            android:id="@+id/lightSensorStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/quranLoading"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center_horizontal"
                        android:visibility="gone" />
                    <TextView
                        android:id="@+id/quranLoadStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp"
                        android:lineSpacingExtra="3dp"
                        android:accessibilityLiveRegion="polite" />
                    <Button android:id="@+id/quranRetry" style="@style/ReadingButton" android:text="Coba lagi" android:visibility="gone" />
                    <Button
                        android:id="@+id/quranJumpToVerse"
                        android:background="?android:attr/selectableItemBackground"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:paddingHorizontal="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:visibility="gone"
                        android:layout_gravity="end"
                        android:text="@string/quran_jump"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textColor="@color/pine" />
                    <LinearLayout
                        android:id="@+id/ayahContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <LinearLayout
                        android:id="@+id/quranPagination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:paddingVertical="12dp">
                        <TextView
                            android:id="@+id/quranPageLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/studio_tint_586f62"
                            android:textSize="13sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <Button
                                android:id="@+id/quranPreviousPage"
                                android:background="?android:attr/selectableItemBackground"
                                android:stateListAnimator="@null"
                                android:elevation="0dp"
                                android:paddingHorizontal="16dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="Sebelumnya"
                                android:textAllCaps="false" />
                            <Button
                                android:id="@+id/quranNextPage"
                                android:background="?android:attr/selectableItemBackground"
                                android:stateListAnimator="@null"
                                android:elevation="0dp"
                                android:paddingHorizontal="16dp"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="Ayat berikutnya"
                                android:textAllCaps="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button
                        android:id="@+id/quranBackToCatalog"
                        style="@style/ReadingButton"
                        android:text="Kembali ke daftar surah"
                        android:background="@drawable/quran_resume_background"
                        android:textColor="@color/pine"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/view_quran_catalog_audio" />
        <LinearLayout
            android:id="@+id/readerAudioDock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="64dp"
            android:visibility="gone"
            android:background="@color/concept_ivory">
            <LinearLayout
                android:id="@+id/quranAudioFolded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">
                <TextView
                    android:id="@+id/quranAudioFoldedTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/reader_audio_folded"
                    android:textColor="@color/pine"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/reader_audio_expand" />
                <ImageButton
                    android:id="@+id/quranAudioFoldedPlay"
                    style="@style/QuranAudioControl"
                    android:src="@drawable/audio_play"
                    android:contentDescription="@string/audio_play" />
                <ImageButton
                    android:id="@+id/quranAudioExpand"
                    style="@style/QuranAudioControl"
                    android:src="@drawable/audio_expand"
                    android:contentDescription="@string/reader_audio_expand" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/readerAudioBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/quranReaderMovement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:paddingHorizontal="12dp"
                    android:background="@color/concept_ivory">
                    <Button
                        android:id="@+id/quranReaderAuto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/design_auto_scroll"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:textColor="@color/pine"
                        android:background="?android:attr/selectableItemBackground" />
                    <Switch
                        android:id="@+id/quranWordFollow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/layout_word_follow"
                        android:textSize="11sp"
                        android:textColor="@color/pine"
                        android:paddingHorizontal="8dp"
                        android:showText="false"
                        android:layout_weight="1" />
                    <ImageButton
                        android:id="@+id/quranAudioOptions"
                        style="@style/QuranAudioControl"
                        android:src="@drawable/study_scene_settings_icon"
                        android:contentDescription="@string/audio_options"
                        android:visibility="visible" />
                    <ImageButton
                        android:id="@+id/quranAudioFoldClose"
                        style="@style/QuranAudioControl"
                        android:src="@drawable/audio_expand"
                        android:rotation="180"
                        android:contentDescription="@string/reader_audio_collapse" />
                </LinearLayout>
                <include layout="@layout/view_quran_audio" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
