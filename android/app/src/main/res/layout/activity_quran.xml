<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quranPageRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/quranRoot" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#FFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
            <ImageButton android:id="@+id/toolbarBack" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_back" android:tint="@color/pine" android:padding="13dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Kembali" />
            <TextView android:id="@+id/quranTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Quran" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/pine" />
            <Spinner android:id="@+id/surahSelector" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                android:spinnerMode="dropdown" android:visibility="gone" android:contentDescription="Pilih surah" />
            <ImageButton android:id="@+id/quranHeaderSearch" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/reading_ic_search" android:tint="@color/pine" android:padding="14dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Cari surah" />
            <ImageButton android:id="@+id/quranCatalogButton" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_book" android:tint="@color/pine" android:padding="14dp" android:visibility="gone"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Daftar surah" />
            <ImageButton android:id="@+id/quranReadingOptions" android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/reading_ic_adjust" android:tint="@color/pine" android:padding="14dp" android:visibility="gone"
                android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Pengaturan bacaan" />
        </LinearLayout>
        <View android:id="@+id/quranHeaderDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9EDE8" />
        <ScrollView android:id="@+id/quranScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:fillViewport="true" android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingBottom="88dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/quranCatalog" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/quranIntro" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Baca dengan tenang, lanjutkan dari ayat terakhirmu." android:visibility="gone" android:textSize="12sp" />
                    <LinearLayout android:id="@+id/quranSearchCard" android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:gravity="center_vertical"
                        android:paddingHorizontal="12dp" android:background="@drawable/reading_search" android:visibility="gone">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/reading_ic_search" android:importantForAccessibility="no" />
                        <EditText android:id="@+id/quranSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                            android:layout_marginStart="10dp" android:background="@null" android:singleLine="true" android:inputType="text"
                            android:imeOptions="actionSearch" android:textSize="14sp" android:textColor="@color/pine" android:textColorHint="#7E8F86"
                            android:hint="Nama atau nomor surah" android:importantForAutofill="no" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/quranResume" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp"
                        android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp" android:background="@drawable/quran_resume_background" android:clickable="true" android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">
                        <ImageView android:id="@+id/quranResumeIcon" android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/reading_ic_bookmark" android:tint="#9A793E" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                            <TextView android:id="@+id/quranResumeHeading" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Lanjut membaca" android:textSize="11sp" android:textColor="#5D7365" />
                            <TextView android:id="@+id/lastReadLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/pine" />
                        </LinearLayout>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_back" android:rotation="180"
                            android:tint="@color/pine" android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
                        <TextView android:id="@+id/quranSurahHeading" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical"
                            android:paddingHorizontal="6dp" android:text="Surah" android:textColor="@color/pine" android:textSize="14sp" android:textStyle="bold" />
                        <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
                        <TextView android:id="@+id/readingAvailable" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="114 surah" android:textSize="11sp" android:textColor="#6A7D72" />
                    </LinearLayout>
                    <View android:layout_width="46dp" android:layout_height="2dp" android:background="@color/pine" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E9EDE8" />
                    <LinearLayout android:id="@+id/quranSurahList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:id="@+id/quranEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="24dp"
                        android:text="Surah tidak ditemukan. Coba nama lainnya." android:textSize="14sp" android:visibility="gone" />
                    <TextView android:id="@+id/quranFootnote" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="16dp" android:textSize="11sp" android:lineSpacingExtra="3dp"
                        android:text="Sumber bacaan: Quran.com / Quran Foundation. Empat surah tersedia bawaan; bagian yang baru dibuka disimpan terbatas di perangkat." />
                </LinearLayout>
                <LinearLayout android:id="@+id/quranReader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp"
                        android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/quran_surah_header" android:padding="16dp">
                        <TextView android:id="@+id/surahMetadata" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:textSize="12sp" android:lineSpacingExtra="4dp" android:textColor="#E5EEE6" />
                        <TextView android:id="@+id/surahArabicTitle" android:layout_width="120dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:gravity="end" android:textDirection="rtl" android:textSize="27sp" android:textColor="@color/white" />
                    </LinearLayout>
                    <TextView android:id="@+id/surahBismillah" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:paddingVertical="22dp" android:gravity="center" android:textDirection="rtl" android:textSize="25sp" android:textColor="@color/pine"
                        android:text="بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ" />
                    <LinearLayout android:id="@+id/quranThemePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                        <Switch android:id="@+id/readingNightSwitch" android:layout_width="match_parent" android:layout_height="48dp"
                            android:text="Mode baca malam" android:textSize="12sp" android:showText="false" />
                        <TextView android:id="@+id/lightSensorStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/quranLoading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
                    <TextView android:id="@+id/quranLoadStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="10sp" android:paddingTop="8dp" android:paddingBottom="12dp" android:lineSpacingExtra="3dp" android:accessibilityLiveRegion="polite" />
                    <Button android:id="@+id/quranRetry" style="@style/ReadingButton" android:text="Coba lagi" android:visibility="gone" />
                    <LinearLayout android:id="@+id/ayahContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <LinearLayout android:id="@+id/quranPagination" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone" android:paddingVertical="12dp">
                        <TextView android:id="@+id/quranPageLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:gravity="center" android:textColor="@color/camel" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                            <Button android:id="@+id/quranPreviousPage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                                android:text="Sebelumnya" android:textAllCaps="false" />
                            <Button android:id="@+id/quranNextPage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
                                android:text="Ayat berikutnya" android:textAllCaps="false" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button android:id="@+id/quranBackToCatalog" style="@style/ReadingButton" android:text="Kembali ke daftar surah"
                        android:background="@drawable/quran_resume_background" android:textColor="@color/pine" android:layout_marginTop="16dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
