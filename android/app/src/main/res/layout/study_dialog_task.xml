<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:labelFor="@id/study_editor_title"
        android:text="@string/study_task_name"
        android:textColor="@color/pine"
        android:textSize="13sp" />
    <EditText
        android:id="@+id/study_editor_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="@string/study_task_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="200"
        android:maxLines="4"
        android:minHeight="56dp"
        android:padding="14dp"
        android:textColor="@color/pine"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:labelFor="@id/study_editor_category"
        android:text="@string/study_category"
        android:textColor="@color/pine"
        android:textSize="13sp" />
    <Spinner
        android:id="@+id/study_editor_category"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:entries="@array/study_categories"
        android:spinnerMode="dropdown" />
</LinearLayout>
