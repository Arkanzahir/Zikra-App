<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/duaRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/daily_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader android:id="@+id/utilitiesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ScrollView android:id="@+id/duaScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingHorizontal="20dp" android:paddingBottom="112dp" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <RelativeLayout android:id="@+id/duaHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="152dp" android:background="@drawable/dua_arabic_surface" android:clipToOutline="true" android:layout_marginBottom="12dp">
                    <ImageView android:id="@+id/duaHeroImage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_alignTop="@+id/duaHeroCopy" android:layout_alignBottom="@id/duaHeroCopy" android:src="@drawable/daily_window" android:scaleType="centerCrop" android:importantForAccessibility="no" />
                    <LinearLayout android:id="@id/duaHeroCopy" android:layout_width="190dp" android:layout_height="wrap_content" android:minHeight="152dp" android:orientation="vertical" android:gravity="center_vertical" android:padding="20dp">
                        <TextView style="@style/DailyCaption" android:text="@string/dua_refined_eyebrow" android:textColor="@color/pine" android:textSize="10sp" android:letterSpacing="0.09" />
                        <TextView style="@style/DailyHeading" android:text="@string/dua_refined_hero" android:textSize="26sp" android:textColor="@color/pine" android:layout_marginTop="10dp" />
                    </LinearLayout>
                </RelativeLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:background="@drawable/reading_search" android:paddingHorizontal="15dp" android:layout_marginBottom="12dp" android:minHeight="56dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/reading_ic_search" android:importantForAccessibility="no" />
                    <EditText android:id="@+id/duaSearch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:background="@null" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" android:textSize="14sp" android:textColor="@color/text" android:textColorHint="@color/app_ink_52665f" android:hint="@string/daily_dua_search" android:importantForAutofill="no" android:contentDescription="Cari doa berdasarkan judul, teks Arab, atau arti" android:minHeight="56dp" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginBottom="16dp" android:fillViewport="false">
                    <LinearLayout android:id="@+id/duaCategories" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" />
                </HorizontalScrollView>
                <LinearLayout android:id="@+id/duaLibraryOpen" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:layout_marginBottom="24dp" android:background="@drawable/dua_library_surface" android:foreground="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:contentDescription="@string/dua_refined_library_access">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/feature_icon_dua" android:tint="@color/daily_ink" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
                        <TextView style="@style/DailyHeading" android:text="@string/dua_refined_library" android:textSize="14sp" />
                        <TextView style="@style/DailyCaption" android:text="@string/dua_refined_library_hint" android:textColor="@color/dua_text_secondary" android:textSize="11sp" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/home_ic_chevron" android:tint="@color/daily_ink" android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView style="@style/DailyHeading" android:text="@string/dua_refined_selection" android:textSize="18sp" />
                        <TextView style="@style/DailyCaption" android:text="@string/dua_refined_offline" android:textColor="@color/dua_text_secondary" android:textSize="11sp" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView android:id="@+id/duaCount" style="@style/DailyCaption" android:layout_width="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:background="@drawable/daily_mint_card" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/duaContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/daily_white_card" android:clipToOutline="true" />
                <TextView android:id="@+id/duaEmpty" style="@style/ReadingBody" android:text="Belum ada doa yang sesuai. Coba kategori atau kata lainnya." android:paddingVertical="24dp" android:visibility="gone" />
                <LinearLayout android:id="@+id/duaVoicePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/ReadingBody" android:id="@+id/duaVoiceStatus" android:text="Menyiapkan suara bahasa Arab…" android:textSize="14sp" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:accessibilityLiveRegion="polite" />
                    <Button android:id="@+id/duaInstallVoice" style="@style/ReadingButton" android:text="Pasang suara bahasa Arab" android:visibility="gone" android:layout_marginBottom="16dp" android:background="@drawable/reading_mint_card" android:textColor="@color/text" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="12dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>