<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/studySchedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:layout_marginTop="16dp">
    <Button android:id="@+id/studyDeadline" style="@style/NearbyButton" android:background="@drawable/bg_nearby_card" android:text="Atur tenggat (opsional)" />
    <Button android:id="@+id/studyDeadlineClear" style="@style/NearbyButton" android:background="?android:attr/selectableItemBackground" android:text="Hapus tenggat" android:visibility="gone" />
    <Switch android:id="@+id/studyReminder" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingVertical="8dp" android:text="Ingatkan saat tenggat" android:textColor="@color/pine" android:textSize="14sp" android:switchPadding="12dp" />
    <TextView android:id="@+id/studyScheduleHint" style="@style/NearbyCaption" android:accessibilityLiveRegion="polite" />
</LinearLayout>
