<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studyPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/studio_cream">
    <LinearLayout
        android:id="@+id/study_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="64dp">
        <com.zikra.app.ui.FeatureHeader
            android:id="@+id/sharedFeatureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ListView
            android:id="@+id/study_tasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
        <Button
            android:id="@+id/study_add"
            style="@style/StudyButton"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pine"
            android:text="@string/study_refresh_add"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
