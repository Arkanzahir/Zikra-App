<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studyPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/study_warm">
    <LinearLayout
        android:id="@+id/study_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="64dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:background="@color/white">
            <ImageButton
                android:id="@+id/study_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="13dp"
                android:src="@drawable/ic_back"
                android:tint="@color/pine"
                android:contentDescription="@string/study_back" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">
                <TextView
                    android:id="@+id/study_screen_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/study_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/pine" />
                <TextView
                    android:id="@+id/study_screen_tagline"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/study_tagline"
                    android:textSize="11sp"
                    android:textColor="@color/study_secondary" />
            </LinearLayout>
        </LinearLayout>
        <ListView
            android:id="@+id/study_tasks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:paddingHorizontal="20dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
        <Button
            android:id="@+id/study_add"
            style="@style/StudyButton"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pine"
            android:text="@string/study_refresh_add"
            android:textColor="@color/white" />
    </LinearLayout>
</FrameLayout>
