<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F7">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="124dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/profile_header"
                android:paddingHorizontal="@dimen/screen_inset"
                android:paddingTop="8dp"
                android:paddingBottom="32dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical">
                    <ImageButton
                        android:id="@+id/toolbarBack"
                        android:layout_width="@dimen/touch_target"
                        android:layout_height="@dimen/touch_target"
                        android:padding="12dp"
                        android:src="@drawable/ic_back"
                        android:tint="@color/white"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Kembali" />
                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Profil Saya"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <View android:layout_width="44dp" android:layout_height="1dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/profile_avatar"
                    android:text="A"
                    android:textColor="#376650"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:contentDescription="Avatar Arkan" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Arkan Firdaus"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mahasiswa · Sukolilo, Surabaya"
                    android:textColor="#C3D7CB"
                    android:textSize="11sp"
                    android:id="@+id/profileRoleCaption" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/profile_header_badge"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Satu langkah baik, setiap hari"
                    android:textColor="#F0F5EF"
                    android:textSize="10sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/profileProgressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="19dp"
                    android:orientation="vertical"
                    android:elevation="1dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Lihat progres harian di Study Hub">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/circle_mint"
                            android:padding="8dp"
                            android:src="@drawable/ic_tasks"
                            android:tint="#598B74"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Progres hari ini"
                            android:textColor="@color/pine"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/profileProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#598B74"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/profileProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="17dp"
                        android:max="100"
                        android:progressTint="#598B74"
                        android:progressBackgroundTint="#EAF0EB" />
                    <TextView
                        android:id="@+id/profileProgressCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#88958C"
                        android:textSize="11sp"
                        android:text="Checklist ibadah dan belajar" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="12dp"
                    android:text="RUANG PRIBADIMU"
                    android:textColor="#98A39A"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/profileRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="5dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="zikra.  ·  A balanced day begins with a small intention.\nProfil lokal · tanpa akun atau sinkronisasi cloud"
                    android:textColor="#A5AEA6"
                    android:textSize="9sp"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
