<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F7">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="124dp">
            <com.zikra.app.ui.FeatureHeader
                android:id="@+id/utilitiesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8F9F4"
                android:paddingHorizontal="@dimen/screen_inset"
                android:paddingTop="8dp"
                android:paddingBottom="32dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/profile_avatar"
                    android:contentDescription="Avatar profil lokal"
                    android:src="@drawable/ic_user"
                    android:tint="@color/pine"
                    android:padding="20dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Pengguna Zikra"
                    android:textColor="@color/pine"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:id="@+id/profileDisplayName" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Profil lokal · tersimpan di perangkat"
                    android:textColor="#52665F"
                    android:textSize="14sp"
                    android:id="@+id/profileRoleCaption" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/reading_mint_card"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Satu langkah baik, setiap hari"
                    android:textColor="#52665F"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="22dp"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/profileProgressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="19dp"
                    android:orientation="vertical"
                    android:elevation="1dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Lihat tugas akademik hari ini di Study Hub">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/circle_mint"
                            android:padding="8dp"
                            android:src="@drawable/ic_tasks"
                            android:tint="#598B74"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Tugas akademik hari ini"
                            android:textColor="@color/pine"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/profileProgressPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="#598B74"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/profileProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="7dp"
                        android:layout_marginTop="17dp"
                        android:max="100"
                        android:progressTint="#598B74"
                        android:progressBackgroundTint="#EAF0EB" />
                    <TextView
                        android:id="@+id/profileProgressCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#52665F"
                        android:textSize="14sp"
                        android:text="Belum ada tugas akademik hari ini" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="12dp"
                    android:text="RUANG PRIBADIMU"
                    android:textColor="#52665F"
                    android:textSize="14sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />
                <LinearLayout
                    android:id="@+id/profileRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="5dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:text="Zikra · belajar dan ibadah dalam keseharian.&#10;Profil lokal · tanpa akun atau sinkronisasi cloud"
                    android:textColor="#52665F"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
