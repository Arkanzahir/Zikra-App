<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/profileRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/refined_background">
    <ScrollView android:id="@+id/profileScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="88dp">
            <com.zikra.app.ui.FeatureHeader android:id="@+id/utilitiesHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/refined_primary" android:paddingHorizontal="24dp" android:paddingTop="8dp" android:paddingBottom="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_space" android:textColor="@color/refined_brand_caption" android:textSize="12sp" android:layout_marginBottom="14dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/dailyProfileInitial" android:layout_width="64dp" android:layout_height="68dp" android:gravity="center" android:background="@drawable/refined_avatar" android:textColor="@color/refined_ink" android:textSize="28sp" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="16dp">
                        <TextView android:id="@+id/profileDisplayName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/refined_on_primary" android:textSize="25sp" android:textStyle="bold" android:accessibilityHeading="true" />
                        <TextView android:id="@+id/profileRoleCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/refined_brand_caption" android:textSize="12sp" android:layout_marginTop="4dp" />
                        <TextView android:id="@+id/dailyProfileEdit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:text="@string/daily_edit_profile" android:textColor="@color/refined_on_primary" android:textSize="13sp" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackgroundBorderless" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="22dp">
                <LinearLayout android:id="@+id/profileReadingCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="18dp" android:background="@drawable/refined_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/feature_icon_quran" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                        <TextView android:id="@+id/profileReadingLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_reading" android:textSize="12sp" android:textColor="@color/refined_muted" />
                        <TextView android:id="@+id/profileLastRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/refined_ink" android:textStyle="bold" android:textSize="17sp" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="10dp" android:src="@drawable/hifz_chevron" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout android:id="@+id/profileWeekCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="18dp" android:background="@drawable/refined_mint_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_week" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/refined_ink" android:accessibilityHeading="true" />
                    <TextView android:id="@+id/profileWeekCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/refined_muted" android:layout_marginTop="5dp" />
                    <com.zikra.app.ui.ActivityWeekView android:id="@+id/profileWeekDays" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_week_detail" android:textSize="11sp" android:textColor="@color/refined_muted" android:layout_marginTop="12dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_goals" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/refined_ink" android:layout_marginTop="24dp" android:layout_marginBottom="10dp" android:accessibilityHeading="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/refined_card">
                    <LinearLayout android:id="@+id/profileProgressCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/feature_icon_study" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:id="@+id/profileProgressPercent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/refined_ink" />
                            <TextView android:id="@+id/profileProgressCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/refined_muted" android:layout_marginTop="3dp" />
                            <ProgressBar android:id="@+id/profileProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" android:progressTint="@color/refined_primary" android:progressBackgroundTint="@color/refined_track" android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/refined_line" android:layout_marginVertical="10dp" />
                    <LinearLayout android:id="@+id/profileHifzCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/feature_icon_hifz" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
                            <TextView android:id="@+id/profileHifzCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/refined_ink" />
                            <TextView android:id="@+id/profileHifzCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/refined_muted" android:layout_marginTop="3dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_saved" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/refined_ink" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:accessibilityHeading="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:id="@+id/dailyProfileQuran" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_marginEnd="5dp" android:padding="12dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/refined_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:contentDescription="@string/daily_quran">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/feature_icon_quran" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_quran" android:textSize="12sp" android:gravity="center" android:textColor="@color/refined_ink" android:layout_marginTop="9dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/dailyProfileHadith" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_marginHorizontal="5dp" android:padding="12dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/refined_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:contentDescription="@string/daily_hadith">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/feature_icon_hadith" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_hadith" android:textSize="12sp" android:gravity="center" android:textColor="@color/refined_ink" android:layout_marginTop="9dp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/dailyProfileDua" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="88dp" android:layout_marginStart="5dp" android:padding="12dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/refined_card" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground" android:contentDescription="@string/daily_dua">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/feature_icon_dua" android:tint="@color/refined_ink" android:importantForAccessibility="no" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/daily_dua" android:textSize="12sp" android:gravity="center" android:textColor="@color/refined_ink" android:layout_marginTop="9dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_preferences" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/refined_ink" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:accessibilityHeading="true" />
                <LinearLayout android:id="@+id/profileRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/refined_card" android:paddingHorizontal="16dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/refined_profile_local" android:textSize="12sp" android:gravity="center" android:textColor="@color/refined_muted" android:paddingVertical="24dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>