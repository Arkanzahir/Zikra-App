<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mushafRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/mushaf_paper">
    <LinearLayout android:id="@+id/mushafHeader" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/toolbarBack" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_back" android:tint="@color/pine" android:padding="14dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/mushaf_back" />
        <TextView android:id="@+id/mushafTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/mushaf_title" android:fontFamily="serif" android:textSize="16sp" android:textColor="@color/pine" />
        <Button android:id="@+id/mushafZoom" style="@style/MushafButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Aa" android:textAllCaps="false" android:contentDescription="@string/mushaf_options" />
        <Button android:id="@+id/mushafTranslation" style="@style/MushafButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/mushaf_more_symbol" android:textSize="22sp" android:contentDescription="@string/mushaf_more" android:textAllCaps="false" />
    </LinearLayout>
    <LinearLayout android:id="@+id/mushafMetadataRow" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingBottom="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/mushafMetadata" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textColor="@color/pine" android:textSize="12sp" />
        <TextView android:id="@+id/mushafJuz" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="serif" android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>
    <ScrollView android:id="@+id/quranScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <HorizontalScrollView android:id="@+id/mushafHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="true" android:scrollbars="none" android:layoutDirection="rtl">
            <com.zikra.app.reading.mushaf.MushafPageView android:id="@+id/mushafPage"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </HorizontalScrollView>
    </ScrollView>
    <TextView android:id="@+id/mushafStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="16dp" android:paddingVertical="3dp" android:gravity="center" android:textSize="10sp"
        android:textColor="@color/muted" android:accessibilityLiveRegion="polite" />
    <Button android:id="@+id/mushafRetry" style="@style/MushafButton" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:text="@string/mushaf_retry" android:visibility="gone" />
    <include layout="@layout/view_mushaf_audio" />
    <LinearLayout android:id="@+id/mushafNavigation" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layoutDirection="ltr">
        <Button android:id="@+id/mushafNext" style="@style/MushafButton" android:textSize="24sp" android:layout_width="64dp" android:layout_height="wrap_content"
            android:text="‹" android:contentDescription="@string/mushaf_next" />
        <Button android:id="@+id/mushafJump" style="@style/MushafButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:minHeight="48dp" android:textAllCaps="false" />
        <Button android:id="@+id/mushafPrevious" style="@style/MushafButton" android:textSize="24sp" android:layout_width="64dp" android:layout_height="wrap_content"
            android:text="›" android:contentDescription="@string/mushaf_previous" />
    </LinearLayout>
</LinearLayout>
