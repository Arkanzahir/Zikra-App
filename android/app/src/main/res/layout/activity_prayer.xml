<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader
            android:id="@+id/sharedFeatureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="110dp"
            android:scrollbars="none"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_inset"
                android:paddingBottom="18dp">
                <Button android:id="@+id/prayerLocation" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:text="Ubah lokasi"
                    android:textAllCaps="false" android:textColor="@color/text" />
                <TextView
                    android:id="@+id/prayerDateCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/app_ink_53665e" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/prayerWeekDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:minHeight="76dp" />
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:background="@drawable/prayer_bg_tabs"
                    android:padding="3dp"
                    android:minHeight="54dp">
                    <TextView
                        android:id="@+id/prayerTodayTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Hari ini"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:background="@drawable/prayer_bg_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp" />
                    <TextView
                        android:id="@+id/prayerWeekTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Pekan ini"
                        android:textSize="14sp"
                        android:textColor="@color/app_ink_53665e"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/prayer_bg_hero"
                    android:minHeight="127dp">
                    <ImageView
                        android:layout_width="165dp"
                        android:layout_height="105dp"
                        android:layout_gravity="bottom|end"
                        android:src="@drawable/mosque_silhouette"
                        android:alpha="0.15"
                        android:scaleType="fitXY"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">
                        <TextView
                            android:id="@+id/prayerNextLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sholat selanjutnya"
                            android:textSize="12sp"
                            android:textColor="@color/app_ink_5b826e" />
                        <TextView
                            android:id="@+id/prayerNextName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Maghrib · 17:41"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/app_ink_214e3c" />
                        <TextView
                            android:id="@+id/prayerCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="00:27:00"
                            android:textSize="27sp"
                            android:textColor="@color/app_ink_386b52"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/prayer_bg_tabs"
                    android:gravity="center_vertical"
                    android:minHeight="82dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sun"
                            android:tint="@color/app_ink_8caa97"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terbit"
                            android:textSize="12sp"
                            android:textColor="@color/app_ink_53665e"
                            android:layout_marginTop="3dp" />
                        <TextView
                            android:id="@+id/prayerSunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05:28"
                            android:textSize="12sp"
                            android:textColor="@color/app_ink_516f5e"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="41dp"
                        android:background="@color/app_line_e0e8e1" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sun"
                            android:tint="@color/app_ink_8caa97"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maghrib"
                            android:textSize="12sp"
                            android:textColor="@color/app_ink_53665e"
                            android:layout_marginTop="3dp" />
                        <TextView
                            android:id="@+id/prayerSunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="17:41"
                            android:textSize="12sp"
                            android:textColor="@color/app_ink_516f5e"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/prayerListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Jadwal hari ini"
                    android:textColor="@color/app_ink_2b4636"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <LinearLayout
                    android:id="@+id/prayerRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/prayerWeekSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/prayerChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_pine"
                    android:text="Checklist ibadah"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
                <Switch
                    android:id="@+id/prayerReminderEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pengingat sholat"
                    android:textSize="14sp"
                    android:textColor="@color/app_ink_4d6a58"
                    android:buttonTint="@color/sage"
                    android:thumbTint="@color/sage"
                    android:minHeight="52dp"
                    android:paddingVertical="12dp" />
                <TextView
                    android:id="@+id/prayerReminderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/adhan_settings_hint" android:textSize="12sp" android:textColor="@color/muted" />
                <Button android:id="@+id/prayerAudioPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="52dp" android:layout_marginTop="12dp" android:text="@string/adhan_preview"
                    android:textAllCaps="false" android:background="@drawable/prayer_bg_row" android:textColor="@color/text" />
                <Button android:id="@+id/prayerAudioStop" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="52dp" android:text="@string/adhan_stop" android:textAllCaps="false" android:visibility="gone"
                    android:background="@drawable/prayer_bg_row" android:textColor="@color/text" />
                <TextView android:id="@+id/prayerAudioStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/muted" android:paddingVertical="8dp" android:accessibilityLiveRegion="polite" />
                <TextView android:id="@+id/prayerBannerSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="52dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="12dp"
                    android:layout_marginTop="4dp" android:background="@drawable/prayer_bg_row" android:clickable="true" android:focusable="true"
                    android:text="@string/adhan_banner_settings" android:textSize="14sp" android:textColor="@color/text"
                    android:drawableEnd="@drawable/home_ic_chevron" android:drawablePadding="12dp" />
                <TextView android:id="@+id/prayerBannerHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="@string/adhan_banner_hint"
                    android:textSize="12sp" android:textColor="@color/muted" />
                <Switch android:id="@+id/prayerPauseFocus" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="52dp" android:text="@string/adhan_pause_focus" android:textSize="14sp" android:textColor="@color/text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adhan_pause_hint" android:textSize="12sp" android:textColor="@color/muted" />
                <Switch android:id="@+id/prayerQuietClasses" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="52dp" android:text="@string/adhan_quiet_classes" android:textSize="14sp" android:textColor="@color/text" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adhan_quiet_hint" android:textSize="12sp" android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/prayerAlarmSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:background="@drawable/prayer_bg_row"
                    android:text="Pengaturan notifikasi"
                    android:textColor="@color/sage_active"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="52dp"
                    android:paddingVertical="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/adhan_sound_note"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/muted" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/adhan_schedule_note" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/prayerMethod" android:text="Perhitungan lokasi pilihan. Subuh 20°, Isya 18°, Ashar bayangan 1×; ihtiyati 2 menit (terbit tanpa ihtiyati). Asumsi dekat permukaan laut. Ini hasil perhitungan, bukan jadwal resmi Kemenag; cocokkan dengan masjid setempat."
                    android:textSize="12sp"
                    android:textColor="@color/app_ink_53665e"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
