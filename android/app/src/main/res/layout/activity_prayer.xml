<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader
            android:id="@+id/sharedFeatureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="110dp"
            android:scrollbars="none"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_inset"
                android:paddingBottom="18dp">
                <TextView
                    android:id="@+id/prayerDateCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textColor="#53665E" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/prayerWeekDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:minHeight="76dp" />
                </HorizontalScrollView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:background="@drawable/prayer_bg_tabs"
                    android:padding="3dp"
                    android:minHeight="54dp">
                    <TextView
                        android:id="@+id/prayerTodayTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Hari ini"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:background="@drawable/prayer_bg_green"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp" />
                    <TextView
                        android:id="@+id/prayerWeekTab"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Pekan ini"
                        android:textSize="14sp"
                        android:textColor="#53665E"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:paddingVertical="12dp" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:background="@drawable/prayer_bg_hero"
                    android:minHeight="127dp">
                    <ImageView
                        android:layout_width="165dp"
                        android:layout_height="105dp"
                        android:layout_gravity="bottom|end"
                        android:src="@drawable/mosque_silhouette"
                        android:alpha="0.15"
                        android:scaleType="fitXY"
                        android:importantForAccessibility="no" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="17dp">
                        <TextView
                            android:id="@+id/prayerNextLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sholat selanjutnya"
                            android:textSize="12sp"
                            android:textColor="#5B826E" />
                        <TextView
                            android:id="@+id/prayerNextName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Maghrib · 17:41"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#214E3C" />
                        <TextView
                            android:id="@+id/prayerCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="00:27:00"
                            android:textSize="27sp"
                            android:textColor="#386B52"
                            android:fontFamily="sans-serif-light" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:background="@drawable/prayer_bg_tabs"
                    android:gravity="center_vertical"
                    android:minHeight="82dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sun"
                            android:tint="#8CAA97"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Terbit"
                            android:textSize="12sp"
                            android:textColor="#53665E"
                            android:layout_marginTop="3dp" />
                        <TextView
                            android:id="@+id/prayerSunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05:28"
                            android:textSize="12sp"
                            android:textColor="#516F5E"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="41dp"
                        android:background="#E0E8E1" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_sun"
                            android:tint="#8CAA97"
                            android:importantForAccessibility="no" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maghrib"
                            android:textSize="12sp"
                            android:textColor="#53665E"
                            android:layout_marginTop="3dp" />
                        <TextView
                            android:id="@+id/prayerSunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="17:41"
                            android:textSize="12sp"
                            android:textColor="#516F5E"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/prayerListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Jadwal hari ini"
                    android:textColor="#2B4636"
                    android:textStyle="bold"
                    android:textSize="13sp" />
                <LinearLayout
                    android:id="@+id/prayerRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:id="@+id/prayerWeekSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
                <Button
                    android:id="@+id/prayerChecklist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_pine"
                    android:text="Checklist ibadah"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
                <Switch
                    android:id="@+id/prayerReminderEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Pengingat sholat"
                    android:textSize="14sp"
                    android:textColor="#4D6A58"
                    android:buttonTint="@color/sage"
                    android:thumbTint="@color/sage"
                    android:minHeight="52dp"
                    android:paddingVertical="12dp" />
                <TextView
                    android:id="@+id/prayerReminderStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/muted" />
                <TextView
                    android:id="@+id/prayerAlarmSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:background="@drawable/prayer_bg_row"
                    android:text="Pengaturan notifikasi"
                    android:textColor="@color/sage_active"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="52dp"
                    android:paddingVertical="12dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Perhitungan Sukolilo · WIB. Subuh 20°, Isya 18°, Ashar bayangan 1×; ihtiyati 2 menit (terbit tanpa ihtiyati). Asumsi dekat permukaan laut. Ini hasil perhitungan, bukan jadwal resmi Kemenag; cocokkan dengan masjid setempat."
                    android:textSize="12sp"
                    android:textColor="#53665E"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
