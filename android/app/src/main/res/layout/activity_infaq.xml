<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/infaqRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader
            android:id="@+id/sharedFeatureHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:padding="24dp"
                    android:orientation="vertical"
                    android:background="@drawable/reading_mint_card">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_donate"
                        android:background="@drawable/circle_mint"
                        android:tint="@color/sage"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Kebaikan kecil, manfaat yang besar."
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Berbagi melalui masjid dan komunitas kampus yang kamu kenal."
                        android:textSize="15sp"
                        android:textColor="@color/muted"
                        android:lineSpacingExtra="5dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="Mulai dari lingkungan terdekat"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Masjid Manarul Ilmi ITS"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sukolilo, Surabaya\nIbadah · pendidikan · kegiatan sosial"
                        android:textSize="15sp"
                        android:textColor="@color/muted"
                        android:lineSpacingExtra="5dp" />
                    <Button
                        android:id="@+id/infaqMaps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_amber"
                        android:backgroundTint="@color/amber"
                        android:text="Petunjuk ke masjid"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:minHeight="52dp"
                        android:paddingVertical="12dp"
                        android:textSize="14sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="18dp"
                    android:background="@drawable/reading_mint_card"
                    android:text="Infaq disalurkan langsung melalui pengurus atau kanal resmi masjid. Aplikasi belum menerima pembayaran atau menampilkan rekening donasi."
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="5dp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
