<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/locationRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/onboarding_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <com.zikra.app.ui.FeatureHeader android:id="@+id/locationHeader" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Harimu, di tempatmu." android:textColor="@color/pine" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Satu lokasi untuk jadwal sholat, cuaca, arah Kiblat, dan masjid di sekitarmu." android:textColor="@color/onboarding_muted" android:textSize="15sp" android:lineSpacingExtra="4dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:padding="20dp" android:background="@drawable/bg_location_selected">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LOKASI YANG DIPAKAI" android:textSize="11sp" android:letterSpacing="0.08" android:textColor="#D2DFD8" />
                    <TextView android:id="@+id/locationCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/white" />
                    <TextView android:id="@+id/locationDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:lineSpacingExtra="4dp" android:textColor="#D2DFD8" />
                </LinearLayout>
                <Button android:id="@+id/locationAutomatic" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="20dp" android:background="@drawable/bg_pine" android:text="Gunakan lokasi saya" android:textAllCaps="false" android:textColor="@color/white" android:textSize="15sp" android:padding="12dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Lokasi diambil saat diminta. Tidak melacak perjalanan atau menyalakan GPS terus-menerus." android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="@color/onboarding_muted" />
                <TextView android:id="@+id/locationStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="14sp" android:textColor="@color/pine" android:lineSpacingExtra="4dp" android:accessibilityLiveRegion="polite" />
                <Button android:id="@+id/locationSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Pengaturan lokasi perangkat" android:textAllCaps="false" android:textColor="@color/pine" android:visibility="gone" android:background="@drawable/bg_location_outline" android:stateListAnimator="@null" android:elevation="0dp" android:padding="12dp" android:layout_marginTop="8dp" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Atau pilih kota" android:textStyle="bold" android:textColor="@color/pine" android:textSize="19sp" />
                <EditText android:id="@+id/locationQuery" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:hint="Cari kota, misalnya Makassar" android:inputType="textCapWords" android:imeOptions="actionSearch" android:maxLines="1" android:maxLength="100" android:textSize="16sp" android:textColor="@color/pine" android:padding="12dp" android:background="@drawable/prayer_bg_row" />
                <Button android:id="@+id/locationSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Cari kota" android:textAllCaps="false" android:textColor="@color/pine" android:background="@drawable/bg_location_outline" android:stateListAnimator="@null" android:elevation="0dp" android:padding="12dp" android:layout_marginTop="8dp" android:textSize="14sp" />
                <TextView android:id="@+id/locationResultsLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Pilihan kota offline · pusat kota" android:textSize="12sp" android:textColor="@color/onboarding_muted" />
                <LinearLayout android:id="@+id/locationResults" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                <TextView android:id="@+id/locationAttribution" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:minHeight="48dp" android:gravity="center_vertical" android:text="Pencarian kota: Open-Meteo / GeoNames ↗" android:textSize="12sp" android:textColor="@color/onboarding_muted" android:clickable="true" android:focusable="true" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>