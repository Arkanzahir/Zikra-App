<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:background="@drawable/reading_white_card"
    android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/ayahNumber"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/reading_number"
            android:textColor="@color/pine"
            android:gravity="center"
            android:textSize="12sp" />
        <Button
            android:id="@+id/ayahBookmark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:text="Tandai terakhir dibaca"
            android:textAllCaps="false"
            android:textColor="#CF9447"
            android:textSize="11sp"
            android:gravity="end|center_vertical" />
    </LinearLayout>
    <TextView
        android:id="@+id/ayahArabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/pine"
        android:gravity="end"
        android:textDirection="rtl"
        android:textSize="29sp"
        android:lineSpacingExtra="13dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp" />
    <TextView
        style="@style/ReadingBody"
        android:id="@+id/ayahTranslation"
        android:textColor="#637570" />
</LinearLayout>
