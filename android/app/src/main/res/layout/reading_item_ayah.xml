<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingTop="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/ayahMore" android:layout_width="48dp" android:layout_height="48dp" android:padding="15dp" android:src="@drawable/study_ic_more" android:tint="#586F62" android:contentDescription="Putar, tandai, salin atau bagikan ayat" android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/ayahLastReadStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="start" android:textSize="11sp" android:textColor="#806337" />
        <ImageButton android:id="@+id/ayahPlay" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:src="@drawable/audio_play" android:contentDescription="Putar ayat" />
        <ImageButton android:id="@+id/ayahBookmark" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" android:src="@drawable/reading_ic_bookmark" android:contentDescription="Tandai terakhir dibaca" />
        <TextView android:id="@+id/ayahNumber" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/reading_surah_number" android:gravity="center" android:textSize="12sp" android:textColor="#806337" />
    </LinearLayout>
    <TextView android:id="@+id/ayahAudioStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/pine" android:visibility="gone" />
    <TextView android:id="@+id/ayahArabic" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:textAlignment="viewEnd" android:textDirection="rtl" android:textSize="32sp" android:lineSpacingExtra="12dp" android:layout_marginTop="4dp" android:layout_marginBottom="14dp" android:textColor="@color/pine" />
    <TextView android:id="@+id/ayahTranslation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:lineSpacingExtra="5dp" android:textColor="#50665B" />
    <View android:id="@+id/ayahDivider" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="#E3E8E2" />
</LinearLayout>
