<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="0dp">
    <LinearLayout
        android:id="@+id/ayahLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/ayahNumber"
            android:layout_width="44dp"
            android:layout_height="48dp"
            android:background="@drawable/reading_surah_number"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/app_ink_806337"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/layout_verse_actions" />
        <ImageButton
            android:id="@+id/ayahPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="visible"
            android:src="@drawable/reading_audio_speaker"
            android:contentDescription="Putar ayat"
            android:padding="14dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView
            android:id="@+id/ayahArabic"
            android:fontFamily="@font/amiri_quran"
            android:includeFontPadding="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textDirection="rtl"
            android:textSize="32sp"
            android:lineSpacingExtra="8dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="0dp"
            android:textColor="@color/text"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/ayahLastReadStatus"
        android:layout_width="match_parent"
        android:layout_weight="0"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textSize="11sp"
        android:textColor="@color/app_ink_806337"
        android:visibility="gone" />
    <TextView
        android:id="@+id/ayahAudioStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text"
        android:visibility="gone"
        android:layout_marginTop="3dp" />
    <TextView
        android:id="@+id/ayahTranslation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/app_ink_50665b"
        android:layout_marginTop="12dp" />
    <View
        android:id="@+id/ayahDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/app_line_e3e8e2" />
    <ImageButton
        android:id="@+id/ayahMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="15dp"
        android:src="@drawable/study_ic_more"
        android:tint="@color/app_ink_586f62"
        android:contentDescription="Putar, tandai, salin atau bagikan ayat"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />
    <ImageButton
        android:id="@+id/ayahBookmark"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:src="@drawable/reading_ic_bookmark"
        android:contentDescription="Tandai terakhir dibaca" />
</LinearLayout>
