# Template only. Inject the existing operator-selected provider key outside Git/image/APK.
ZIKRA_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_VISION_MODEL=@cf/qwen/qwen3.8-27b
# Set true only after verifying Workers Free.
ZIKRA_ASSISTANT_FREE_PLAN_CONFIRMED=false
# Inactive legacy provider; no automatic fallback.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
# Optional vision model; omit until verified against synthetic photo/PDF inputs.
# FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
ZIKRA_ACCESS_MODE=installation
ZIKRA_CLIENTS_FILE=/data/clients.json
ZIKRA_USAGE_FILE=/data/usage.json
ZIKRA_DAILY_LIMIT=100
HOST=0.0.0.0
PORT=8787
