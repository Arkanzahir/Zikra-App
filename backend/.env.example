# Private test template; C02 public authentication/hosting is still required.
# Load on the server only. Do not put either secret into an APK or Git/logs.
# Use the operator-selected provider key; never expose it to Git/APK/logs.
FEATHERLESS_API_KEY=
# Exact model ID from your Featherless account's available models.
FEATHERLESS_MODEL=
# Optional exact vision-capable model ID, only after verifying account access.
# Omit this variable to keep photo/scanned-PDF requests unavailable.
# FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# Optional server-only image generation. Keep disabled until account access is tested.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# ZIKRA_IMAGES_ENABLED=true
# ZIKRA_IMAGES_FREE_PLAN_CONFIRMED=true
# Generate a random access code with at least 32 characters for private testing.
ZIKRA_CLIENT_TOKEN=
# Keep loopback behind a TLS reverse proxy. Never expose this HTTP port publicly.
HOST=127.0.0.1
PORT=8787
