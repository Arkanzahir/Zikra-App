# Private test template; C02 public authentication/hosting is still required.
# Load on the server only. Do not put either secret into an APK or Git/logs.
# Use the operator-selected provider key; never expose it to Git/APK/logs.
FEATHERLESS_API_KEY=
# Exact model ID from your Featherless account's available models.
FEATHERLESS_MODEL=
# Generate a random access code with at least 32 characters for private testing.
ZIKRA_CLIENT_TOKEN=
# Keep loopback behind a TLS reverse proxy. Never expose this HTTP port publicly.
HOST=127.0.0.1
PORT=8787
