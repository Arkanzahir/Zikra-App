# Server-side Vercel environment only; retain the existing operator-selected provider key.
ZIKRA_AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/qwen/qwen3.8-27b
CLOUDFLARE_VISION_MODEL=@cf/qwen/qwen3.8-27b
# Set true only after verifying Workers Free. Never enable a paid fallback.
ZIKRA_ASSISTANT_FREE_PLAN_CONFIRMED=false
# Inactive legacy provider: selected only by explicit ZIKRA_AI_PROVIDER=featherless.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=
# Optional vision model; verify account access with synthetic images before enabling.
# FEATHERLESS_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace KV_REST_API_URL/KV_REST_API_TOKEN are accepted instead when canonical names are absent.
# Use a separate namespace/database for previews and tests; never share production counters.
ZIKRA_REDIS_PREFIX=zikra:prod:v1:
ZIKRA_DAILY_LIMIT=100

# Optional E02 server-only push sender. Never place this service-account JSON in Android/Git.
# See deploy/EARTHQUAKE_PUSH.md; keep the GitHub activation variable false until approved.
ZIKRA_FIREBASE_SERVICE_ACCOUNT_JSON=
ZIKRA_QUAKE_CRON_SECRET=
# ZIKRA_QUAKE_TOPIC=zikra-earthquake-beta-v1
